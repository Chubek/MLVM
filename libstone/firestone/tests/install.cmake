set(prefix "${FIRESTONE_BINARY}/install-test/prefix")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${FIRESTONE_BINARY}" --prefix "${prefix}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Firestone installation failed")
endif()
# Move the prefix to exercise relocation of imported target include paths.
set(relocated "${FIRESTONE_BINARY}/install-test/relocated")
file(REMOVE_RECURSE "${relocated}")
file(RENAME "${prefix}" "${relocated}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${FIRESTONE_SOURCE}/tests/consumer"
  -B "${FIRESTONE_BINARY}/install-test/consumer" "-DCMAKE_PREFIX_PATH=${relocated}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Firestone consumer configure failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${FIRESTONE_BINARY}/install-test/consumer" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Firestone consumer build failed")
endif()
execute_process(COMMAND "${FIRESTONE_BINARY}/install-test/consumer/consumer" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Firestone installed consumer failed")
endif()
execute_process(COMMAND "${FIRESTONE_BINARY}/install-test/consumer/vm_consumer" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Firestone installed VM consumer failed")
endif()
execute_process(COMMAND "${FIRESTONE_BINARY}/install-test/consumer/foundation_consumer" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Firestone installed foundation consumer failed")
endif()
