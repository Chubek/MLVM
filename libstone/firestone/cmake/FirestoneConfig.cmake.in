@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@FIRESTONE_ENABLE_OPENMP@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/FirestoneTargets.cmake")
foreach(component IN LISTS Firestone_FIND_COMPONENTS)
  if(TARGET Firestone::${component})
    set(Firestone_${component}_FOUND TRUE)
  else()
    set(Firestone_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(Firestone)
