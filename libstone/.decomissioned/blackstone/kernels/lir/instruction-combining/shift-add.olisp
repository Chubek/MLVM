(define-kernel
  :id "blackstone.lir.instruction-combining.shift-add"
  :name "Shift-Add Combining"
  :stage lir
  (category instruction-combination)
  (paradigms target-specific rule-based)
  (objective "Replace a shift followed by an add with a single combined operation when the target supports it.")
  (requires
    (capability machine-operations)
    (capability target-description))
  (preconditions
    (target-supports-combined-operation)
    (semantics-match))
  (forbids
    (unmodeled-observable-effects))
  (transform
    (combine (sequence (machine-op :kind "SHIFT") (machine-op :kind "ADD"))
             (target-pattern :name "combined-shift-add-pattern")))
  (correctness
    (preserve-observable-behavior))
  (expected-effects "Replaces a shift-add sequence with a single combined operation.")
  (limitations "Applies only when the target supports a combined operation.")
  (documentation
    (purpose "Combine shift-add sequences into single operations.")
    (motivation "Instruction combining reduces instruction count.")
    (applicability "Applies to shift-add sequences when the target supports a combined operation.")
    (semantic-assumptions "The target supports a combined operation with matching semantics.")
    (known-limitations "Does not combine when the target lacks a suitable instruction.")
    (testing-strategy "Supported, unsupported, and semantics-mismatch cases are exercised.")))
