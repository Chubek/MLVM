(define-kernel
  :id "blackstone.lir.instruction-combining.compare-compare"
  :name "Compare-Compare Combining"
  :stage lir
  (category instruction-combination)
  (paradigms target-specific rule-based)
  (objective "Replace two comparisons with a single comparison when the target supports it.")
  (requires
    (capability machine-operations)
    (capability target-description))
  (preconditions
    (target-supports-combined-comparison)
    (semantics-match))
  (forbids
    (unmodeled-observable-effects))
  (transform
    (combine (sequence (machine-op :kind "COMPARE") (machine-op :kind "COMPARE"))
             (target-pattern :name "combined-comparison-pattern")))
  (correctness
    (preserve-observable-behavior))
  (expected-effects "Replaces two comparisons with a single combined comparison.")
  (limitations "Applies only when the target supports a combined comparison.")
  (documentation
    (purpose "Combine two comparisons into one.")
    (motivation "Instruction combining reduces instruction count.")
    (applicability "Applies to comparison sequences when the target supports a combined comparison.")
    (semantic-assumptions "The target supports a combined comparison with matching semantics.")
    (known-limitations "Does not combine when the target lacks a suitable instruction.")
    (testing-strategy "Supported, unsupported, and semantics-mismatch cases are exercised.")))
