(define-kernel
  :id "blackstone.mir.control-flow.constant-branch-folding"
  :name "MIR Constant Branch Folding"
  :stage mir
  (category control-flow-simplification)
  (paradigms control-flow-graph)
  (objective "Replace a conditional branch on a constant condition with an unconditional jump.")
  (requires
    (capability explicit-control-flow)
    (analysis constant-value-analysis))
  (preconditions
    (branch-condition-is-constant))
  (forbids
    (unmodeled-observable-effects))
  (transform
    (rewrite (branch (boolean c) true-block false-block) (jump (selected-block c))))
  (correctness
    (preserve-observable-behavior))
  (expected-effects "Replaces a conditional branch on a constant with an unconditional jump.")
  (limitations "Applies only when the branch condition is a known constant.")
  (documentation
    (purpose "Fold conditional branches on constant conditions.")
    (motivation "Removing constant branches simplifies control flow.")
    (applicability "Applies to conditional branch nodes with a known constant condition.")
    (semantic-assumptions "The branch condition is a known constant.")
    (known-limitations "Does not fold branches with non-constant conditions.")
    (testing-strategy "True and false constant conditions are exercised.")))
