(define-kernel
  :id "blackstone.mir.control-flow.empty-block-elimination"
  :name "MIR Empty Block Elimination"
  :stage mir
  (category control-flow-simplification)
  (paradigms control-flow-graph)
  (objective "Remove an empty basic block and redirect its predecessors to its successor.")
  (requires
    (capability explicit-control-flow))
  (preconditions
    (block-is-empty)
    (block-has-single-successor))
  (forbids
    (unmodeled-observable-effects))
  (transform
    (merge (block :id empty-block) (block :id successor)))
  (correctness
    (preserve-observable-behavior)
    (maintain-valid-control-flow-edges))
  (expected-effects "Removes an empty basic block and redirects its predecessors.")
  (limitations "Applies only to empty blocks with a single successor.")
  (documentation
    (purpose "Remove empty basic blocks.")
    (motivation "Removing empty blocks simplifies control flow.")
    (applicability "Applies to basic blocks containing only a jump to a single successor.")
    (semantic-assumptions "The block is empty and has a single successor.")
    (known-limitations "Does not remove blocks with multiple successors.")
    (testing-strategy "Single-successor and multi-successor cases are exercised.")))
