(define-kernel
  :id "blackstone.hir.constant-folding.integer-bitwise-and"
  :name "Integer Bitwise And Constant Folding"
  :stage hir
  (category constant-evaluation)
  (paradigms algebraic-rewriting rule-based)
  (objective "Evaluate a bitwise and whose operands are both known constants.")
  (requires
    (capability typed-expressions)
    (capability integer-constant-operands)
    (analysis constant-value-analysis))
  (preconditions
    (operation-has-defined-compile-time-semantics))
  (forbids
    (operation-has-observable-side-effects))
  (transform
    (fold (bitwise-and (integer a) (integer b)) (integer-result (bitwise-and a b))))
  (correctness
    (preserve-observable-behavior))
  (expected-effects "Replaces a constant bitwise and with its compile-time value.")
  (limitations "Requires both operands to be known constants.")
  (documentation
    (purpose "Fold a constant bitwise and into its compile-time result.")
    (motivation "Removing constant bitwise operations reduces run-time work.")
    (applicability "Applies to bitwise and nodes with two known integer constant operands.")
    (semantic-assumptions "The IR's bitwise semantics are preserved.")
    (known-limitations "Does not propagate constants.")
    (testing-strategy "All-bits, no-bits, and mixed cases are exercised.")))
