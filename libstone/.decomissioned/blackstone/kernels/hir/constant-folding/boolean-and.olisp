(define-kernel
  :id "blackstone.hir.constant-folding.boolean-and"
  :name "Boolean And Constant Folding"
  :stage hir
  (category constant-evaluation)
  (paradigms algebraic-rewriting rule-based)
  (objective "Evaluate a Boolean and whose operands are both known constants.")
  (requires
    (capability typed-expressions)
    (capability compile-time-constant-operands)
    (analysis constant-value-analysis))
  (preconditions
    (operation-has-defined-compile-time-semantics))
  (forbids
    (operation-has-observable-side-effects))
  (transform
    (fold (boolean-and (boolean a) (boolean b)) (boolean-result (bool-and a b))))
  (correctness
    (preserve-observable-behavior))
  (expected-effects "Replaces a constant Boolean and with its compile-time value.")
  (limitations "Requires both operands to be known constants.")
  (documentation
    (purpose "Fold a constant Boolean and into its compile-time result.")
    (motivation "Removing constant Boolean operations reduces run-time work.")
    (applicability "Applies to Boolean and nodes with two known Boolean constant operands.")
    (semantic-assumptions "The IR's Boolean semantics are preserved.")
    (known-limitations "Does not propagate constants.")
    (testing-strategy "All four truth-value combinations are exercised.")))
