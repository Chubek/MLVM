ruleset "spirv" {
  nonterminal stmt = 1;
  nonterminal value = 0;
  terminal INPUT(0);
  terminal ISA_begin_5finvocation_5finterlock_5fext(1);
  terminal ISA_composite_5fconstruct_5fcontinued_5fintel(1);
  terminal ISA_constant_5fcomposite_5fcontinued_5fintel(1);
