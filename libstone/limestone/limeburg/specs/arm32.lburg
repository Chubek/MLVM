ruleset "arm32" {
  nonterminal stmt = 1;
  nonterminal value = 0;
  terminal CONST(0);
  terminal INPUT(0);
  terminal ISA_adc(3);
  terminal ISA_adc_5fimm(3);
  terminal ISA_add(2);
  terminal ISA_add_5fimm(2);
  terminal ISA_adds(2);
  terminal ISA_and(2);
