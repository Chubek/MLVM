  nonterminal value = 0;
  terminal CONST(0);
  terminal INPUT(0);
  terminal ISA_arsh32(2);
  terminal ISA_arsh32i(2);
  terminal ISA_arsh64(2);
  terminal ISA_arsh64i(2);
