  terminal ISA_ldxdw(2);
  terminal ISA_ldxh(2);
  terminal ISA_ldxw(2);
  terminal ISA_le16(2);
  terminal ISA_le32(2);
  terminal ISA_le64(2);
  terminal ISA_lsh32(2);
  terminal ISA_lsh32i(2);
  terminal ISA_lsh64(2);
  terminal ISA_lsh64i(2);
  terminal ISA_mod32(1);
  terminal ISA_mod32i(1);
  terminal ISA_mod64(1);
  terminal ISA_mod64i(1);
  terminal ISA_mov32(1);
  terminal ISA_mov32i(0);
  terminal ISA_mov64(1);
  terminal ISA_mov64i(0);
  terminal ISA_neg32(0);
  terminal ISA_neg64(0);
  terminal ISA_rsh32(2);
