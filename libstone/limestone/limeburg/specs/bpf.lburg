  terminal ISA_jge(4);
  terminal ISA_jge32(4);
  terminal ISA_jgt(4);
  terminal ISA_jgt32(4);
  terminal ISA_jle(4);
  terminal ISA_jle32(4);
  terminal ISA_jlt(4);
  terminal ISA_jlt32(4);
  terminal ISA_jne(4);
  terminal ISA_jne32(4);
  terminal ISA_jset(4);
  terminal ISA_jset32(4);
  terminal ISA_jsge(4);
  terminal ISA_jsge32(4);
  terminal ISA_jsgt(4);
  terminal ISA_jsgt32(4);
  terminal ISA_jsle(4);
