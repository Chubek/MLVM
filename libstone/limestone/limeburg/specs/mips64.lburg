ruleset "mips64" {
  nonterminal stmt = 1;
  nonterminal value = 0;
  terminal CONST(0);
  terminal INPUT(0);
  terminal ISA_add(2);
  terminal ISA_addiu(2);
  terminal ISA_addu(2);
  terminal ISA_and(2);
  terminal ISA_andi(2);
  terminal ISA_b(1);
  terminal ISA_beq(2);
  terminal ISA_beql(4);
  terminal ISA_beqz(2);
  terminal ISA_bgez(2);
  terminal ISA_bgtz(2);
  terminal ISA_blez(2);
  terminal ISA_bltz(2);
  terminal ISA_bne(2);
  terminal ISA_bnel(4);
  terminal ISA_bnez(2);
  terminal ISA_clo(3);
  terminal ISA_clz(3);
  terminal ISA_dadd(3);
  terminal ISA_daddi(3);
  terminal ISA_daddiu(3);
  terminal ISA_daddu(3);
  terminal ISA_dclo(3);
  terminal ISA_dclz(3);
  terminal ISA_ddiv(2);
  terminal ISA_ddivu(2);
  terminal ISA_dsllv(3);
  terminal ISA_dsrav(3);
  terminal ISA_dsrlv(3);
  terminal ISA_dsub(3);
