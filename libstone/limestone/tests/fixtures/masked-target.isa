arch masked_target { word_size=64; addr_size=64; endian=little; }
profile { family="fixture"; model="masked-register-machine"; version="1"; execution_model="register-counter"; }
tooling { bin2bin={schema_version=1; instruction_encoding="masked"; execution_domain="bytecode"; word_size=64; address_size=64; endianness="little";}; }
regclass G { r0(64)=0, r1(64)=1, r2(64)=2, }
encoding ADD { width=24; base=9; mask=65535; fields={result={lsb=16; width=2; kind=register; class=G;}; input={lsb=18; width=2; kind=register; class=G;}; immediate={lsb=20; width=4; kind=signed;};}; }
encoding BR { width=24; base=10; mask=65535; fields={destination={lsb=16; width=8; kind=pc_relative; pc_base=end;};}; }
encoding RET { width=24; base=11; mask=16777215; }
op addi { encoding=ADD; semantics="(set $result (add $input $immediate))"; tooling={binary_translation={schema_version=1; equivalence_basis="semantics";};}; }
op jump { encoding=BR; semantics="(branch_if flag $destination)"; tooling={binary_translation={schema_version=1; equivalence_basis="semantics"; control_flow=conditional_branch; target_operand=destination;};}; }
op return { encoding=RET; semantics="(return)"; tooling={binary_translation={schema_version=1; equivalence_basis="semantics"; control_flow=return;};}; }
