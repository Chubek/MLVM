arch riscv64 { word_size = 64; addr_size = 64; endian = little; align = 4; }


profile {
  family = "RISC_V";
  model = "RV64";
  version = "RV64GC_plus";
  word_size = 64;
  address_size = 64;
  endianness = "little";
  instruction_encoding = "fixed32_with_extensions";
  execution_model = "scalar_target_dependent";
  register_model = "register";
  extensions = ["I", "M", "A", "F", "D", "C", "Zicsr", "Zifencei", "Zba", "Zbb", "Zbc", "Zbs", "Zicond", "Zihintpause", "Zfa", "Zfh", "Zfhmin"];
  register_classes = ["GPR", "FPR"];
  fixed_registers = ["x0"];
  zero_register = "x0";
  operation_classes = ["arithmetic", "atomic", "branch", "compare", "convert", "load", "misc", "store", "system"];
  instruction_count = 252;
  encoding_widths = ["32"];
  coverage = "source_inventory";
  encoding_layout = { base_length = "32"; extensions_may_add_lengths = true; };
}
compiler {
  instruction_selection {
    strategy = "target_pattern_matching";
    opcode_classes = ["arithmetic", "atomic", "branch", "compare", "convert", "load", "misc", "store", "system"];
    register_classes = ["GPR", "FPR"];
    immediate_folding = true;
    addressing_mode_folding = true;
    branch_form_selection = true;
    pseudo_expansion = "target_dependent";
    cost_model = "target_microarchitecture";
  }
  instruction_scheduling {
    strategy = "dependency_aware_target_scheduler";
    dependency_ordering = true;
    memory_dependence_analysis = true;
    control_dependence_analysis = true;
    latency_model = "target_microarchitecture";
    resource_model = "target_microarchitecture";
    packetization = false;
  }
  register_allocation {
    strategy = "target_register_allocation";
    register_classes = ["GPR", "FPR"];
    fixed_registers = ["x0"];
    zero_register = "x0";
    caller_saved = "abi_dependent";
    callee_saved = "abi_dependent";
    spill_policy = "target_dependent";
  }
  optimization {
    legality_model = "isa_and_memory_model";
    transforms = ["constant_folding", "copy_propagation", "dead_code_elimination", "common_subexpression_elimination", "peephole_rewrite", "branch_simplification", "load_store_motion_target_dependent", "strength_reduction_target_dependent", "addressing_mode_folding", "branch_relaxation_target_dependent", "immediate_materialization", "compressed_extension_selection_target_dependent"];
    instruction_combining = true;
    peephole_optimization = true;
    constant_folding = true;
    dead_code_elimination = true;
    common_subexpression_elimination = true;
    loop_optimization = "target_dependent";
    vectorization = "target_dependent";
    if_conversion = "target_dependent";
    interprocedural_optimization = "abi_and_linkage_dependent";
  }
}
regclass GPR {
    x0(64)=0,
    x1(64)=1,
    x2(64)=2,
    x3(64)=3,
    x4(64)=4,
    x5(64)=5,
    x6(64)=6,
