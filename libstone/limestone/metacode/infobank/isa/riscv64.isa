encoding E_LUI { width = 32;
  base = 0x37;
  rd = 7:5;
  upper = 12:20;
}

op lui { class = misc; encoding = E_LUI;
  operands = rd: GPR, upper: imm;
  syntax = "lui {rd}, {upper}";
  semantics = "(set rd (move upper))";

  tooling = {
    dataflow = { uses = ["upper"]; defs = ["rd"]; explicit_operands = ["rd", "upper"]; precision = "derived"; flags_read = false; flags_written = false; memory = "none"; control = "fallthrough"; };
    scheduling = { latency = "unknown"; reciprocal_throughput = "unknown"; resource_class = "misc"; resources = ["target_dependent"]; dependency_latency = "target_dependent"; issue_width = "target_dependent"; serializing = false; };
    register_allocation = { operand_constraints = ["rd:GPR", "upper:imm"]; tied_operands = []; fixed_registers = ["x0"]; clobbers = []; early_clobber = []; spillable = true; };
    instruction_selection = { pattern = "move"; opcode_class = "misc"; commutative = false; immediate_folding = true; addressing_mode = "none_or_implicit"; pseudo = false; };
    vmm = { terminator = false; control_flow = "fallthrough"; memory_effect = "none"; may_trap = false; atomic = false; serializing = false; privilege = "unknown"; helper_required = false; };
    disassembly = { mnemonic = "lui"; syntax = "lui {rd}, {upper}"; encoding = "E_LUI"; encoding_width = "32"; opcode = "unknown"; operand_order = ["rd", "upper"]; };
    reverse_engineering = { category = "misc"; semantic_pattern = "move"; control_flow = "fallthrough"; memory_read = false; memory_write = false; branch_target = "none"; xref_kind = "data_or_none"; semantic_confidence = "derived_from_existing_spec"; };
  
    binary_translation = {
      schema_version = 1;
      semantic_source = "semantics";
      encoding_source = "encoding";
      operand_source = "operands";
      dataflow_source = "dataflow";
      control_flow = "fallthrough";
      terminates_block = false;
      branch_target = "none";
      memory_effect = "none";
      may_trap = false;
      atomic = false;
      serializing = false;
      privilege = "unknown";
      pc_effect = "derive_from_semantics_and_control_flow";
      implicit_register_effects = "derive_from_semantics";
      flag_effects = "derive_from_dataflow_and_semantics";
      target_lowering = "instruction_selection.pattern";
      equivalence_basis = "semantics";
    };
}
}

