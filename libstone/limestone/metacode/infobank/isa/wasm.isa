arch wasm { word_size = 32; addr_size = 32; endian = little; align = 1; }


profile {
  family = "WebAssembly";
  model = "Core";
  version = "2_0";
  word_size = 32;
  address_size = 32;
  endianness = "little";
  instruction_encoding = "variable_bytecode";
  execution_model = "stack_machine";
  register_model = "operand_stack_and_locals";
  extensions = ["MVP", "bulk_memory", "reference_types", "multi_value", "tail_call_target_dependent", "SIMD_target_dependent"];
  register_classes = [];
  fixed_registers = [];
  zero_register = "none";
  operation_classes = ["arithmetic", "branch", "compare", "convert", "load", "misc", "store"];
  instruction_count = 200;
  encoding_widths = ["stream"];
  coverage = "source_inventory";
  encoding_layout = { opcode = "LEB_or_byte_sequence"; immediates = "LEB128_or_fixed"; };
}
compiler {
  instruction_selection {
    strategy = "ssa_or_stack_pattern_matching";
    opcode_classes = ["arithmetic", "branch", "compare", "convert", "load", "misc", "store"];
    register_classes = [];
    immediate_folding = true;
    addressing_mode_folding = true;
    branch_form_selection = true;
    pseudo_expansion = "target_dependent";
    cost_model = "target_microarchitecture";
  }
  instruction_scheduling {
    strategy = "IR_dependency_scheduler";
    dependency_ordering = true;
    memory_dependence_analysis = true;
    control_dependence_analysis = true;
    latency_model = "target_microarchitecture";
    resource_model = "target_microarchitecture";
    packetization = false;
  }
  register_allocation {
    strategy = "none_physical_register_allocation";
    register_classes = [];
    fixed_registers = [];
    zero_register = "none";
    caller_saved = "abi_dependent";
    callee_saved = "abi_dependent";
    spill_policy = "target_dependent";
  }
  optimization {
    legality_model = "isa_and_memory_model";
    transforms = ["constant_folding", "copy_propagation", "dead_code_elimination", "common_subexpression_elimination", "peephole_rewrite", "branch_simplification", "load_store_motion_target_dependent", "strength_reduction_target_dependent", "addressing_mode_folding", "branch_relaxation_target_dependent"];
    instruction_combining = true;
    peephole_optimization = true;
    constant_folding = true;
    dead_code_elimination = true;
    common_subexpression_elimination = true;
    loop_optimization = "target_dependent";
    vectorization = "target_dependent";
    if_conversion = "target_dependent";
    interprocedural_optimization = "abi_and_linkage_dependent";
  }
}
encoding W_UNREACHABLE { width = stream;
  base = 0x0;
  sequence = byte(0x0);
}

op unreachable { class = branch; encoding = W_UNREACHABLE;
  operands = ;
  syntax = "unreachable";
  semantics = "(trap)";

  tooling = {
    dataflow = { uses = []; defs = []; explicit_operands = []; precision = "derived"; flags_read = false; flags_written = false; memory = "none"; control = "trap"; };
    scheduling = { latency = "unknown"; reciprocal_throughput = "unknown"; resource_class = "control"; resources = ["target_dependent"]; dependency_latency = "target_dependent"; issue_width = "target_dependent"; serializing = false; };
    register_allocation = { operand_constraints = []; tied_operands = []; fixed_registers = []; clobbers = []; early_clobber = []; spillable = false; };
    instruction_selection = { pattern = "trap"; opcode_class = "branch"; commutative = false; immediate_folding = false; addressing_mode = "none_or_implicit"; pseudo = false; };
    vmm = { terminator = true; control_flow = "trap"; memory_effect = "none"; may_trap = true; atomic = false; serializing = false; privilege = "unknown"; helper_required = false; };
    disassembly = { mnemonic = "unreachable"; syntax = "unreachable"; encoding = "W_UNREACHABLE"; encoding_width = "stream"; opcode = "unknown"; operand_order = []; };
    reverse_engineering = { category = "branch"; semantic_pattern = "trap"; control_flow = "trap"; memory_read = false; memory_write = false; branch_target = "none"; xref_kind = "data_or_none"; semantic_confidence = "derived_from_existing_spec"; };
  
    binary_translation = {
      schema_version = 1;
      semantic_source = "semantics";
      encoding_source = "encoding";
      operand_source = "operands";
      dataflow_source = "dataflow";
      control_flow = "trap";
      terminates_block = true;
      branch_target = "none";
      memory_effect = "none";
      may_trap = true;
      atomic = false;
      serializing = false;
      privilege = "unknown";
      pc_effect = "derive_from_semantics_and_control_flow";
      implicit_register_effects = "derive_from_semantics";
      flag_effects = "derive_from_dataflow_and_semantics";
      target_lowering = "instruction_selection.pattern";
      equivalence_basis = "semantics";
    };
}
}

