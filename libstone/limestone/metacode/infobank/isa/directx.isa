    vmm = { terminator = true; control_flow = "branch"; memory_effect = "none"; may_trap = false; atomic = false; serializing = false; privilege = "unknown"; helper_required = false; };
    disassembly = { mnemonic = "br"; syntax = "br label %{target}"; encoding = "BR"; encoding_width = "text"; opcode = "unknown"; operand_order = ["target"]; };
    reverse_engineering = { category = "branch"; semantic_pattern = "branch"; control_flow = "branch"; memory_read = false; memory_write = false; branch_target = "relative_or_indirect"; xref_kind = "code"; semantic_confidence = "derived_from_existing_spec"; };
  
