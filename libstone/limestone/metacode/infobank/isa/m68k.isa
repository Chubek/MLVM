arch m68k { word_size = 32; addr_size = 32; endian = big; align = 2; }


profile {
  family = "Motorola_68000";
  model = "68000_family";
  version = "base";
  word_size = 32;
  address_size = 32;
  endianness = "big";
  instruction_encoding = "variable";
  execution_model = "scalar_target_dependent";
  register_model = "register";
  extensions = ["integer", "address_registers"];
  register_classes = ["GPR"];
  fixed_registers = [];
  zero_register = "none";
  operation_classes = ["arithmetic", "branch", "compare", "misc", "system"];
  instruction_count = 104;
  encoding_widths = ["16"];
  coverage = "source_inventory";
  encoding_layout = { endian = "big"; variable_length = true; };
}
compiler {
  instruction_selection {
    strategy = "target_pattern_matching";
    opcode_classes = ["arithmetic", "branch", "compare", "misc", "system"];
    register_classes = ["GPR"];
    immediate_folding = true;
    addressing_mode_folding = false;
    branch_form_selection = true;
    pseudo_expansion = "target_dependent";
    cost_model = "target_microarchitecture";
  }
  instruction_scheduling {
    strategy = "dependency_aware_target_scheduler";
    dependency_ordering = true;
    memory_dependence_analysis = false;
    control_dependence_analysis = true;
    latency_model = "target_microarchitecture";
    resource_model = "target_microarchitecture";
    packetization = false;
  }
  register_allocation {
    strategy = "target_register_allocation";
    register_classes = ["GPR"];
    fixed_registers = [];
    zero_register = "none";
    caller_saved = "abi_dependent";
    callee_saved = "abi_dependent";
    spill_policy = "target_dependent";
  }
  optimization {
    legality_model = "isa_and_memory_model";
    transforms = ["constant_folding", "copy_propagation", "dead_code_elimination", "common_subexpression_elimination", "peephole_rewrite", "branch_simplification", "load_store_motion_target_dependent", "strength_reduction_target_dependent", "branch_relaxation_target_dependent"];
    instruction_combining = true;
    peephole_optimization = true;
    constant_folding = true;
    dead_code_elimination = true;
    common_subexpression_elimination = true;
    loop_optimization = "target_dependent";
    vectorization = "target_dependent";
    if_conversion = "target_dependent";
    interprocedural_optimization = "abi_and_linkage_dependent";
  }
}
regclass GPR {
    d0(32)=0,
    d1(32)=1,
    d2(32)=2,
    d3(32)=3,
    d4(32)=4,
    d5(32)=5,
    d6(32)=6,
    d7(32)=7,
    a0(32)=8,
    a1(32)=9,
    a2(32)=10,
    a3(32)=11,
    a4(32)=12,
    a5(32)=13,
    a6(32)=14,
    a7(32)=15,
}

alias sp = a7;
alias usp = a6;
alias fp = a5;

encoding MOVE_B { width = 16;
  base = 0x1000;
  rd = 9:3;
  rs1 = 0:3;
}

op move_b { class = misc; encoding = MOVE_B;
  operands = rd: GPR, rs1: GPR;
  syntax = "move.b ${rs1}, ${rd}";
  semantics = "(set rd (move rs1))";

  tooling = {
    dataflow = { uses = ["rs1"]; defs = ["rd"]; explicit_operands = ["rd", "rs1"]; precision = "derived"; flags_read = false; flags_written = false; memory = "none"; control = "fallthrough"; };
    scheduling = { latency = "unknown"; reciprocal_throughput = "unknown"; resource_class = "misc"; resources = ["target_dependent"]; dependency_latency = "target_dependent"; issue_width = "target_dependent"; serializing = false; };
    register_allocation = { operand_constraints = ["rd:GPR", "rs1:GPR"]; tied_operands = []; fixed_registers = []; clobbers = []; early_clobber = []; spillable = true; };
    instruction_selection = { pattern = "move"; opcode_class = "misc"; commutative = false; immediate_folding = false; addressing_mode = "none_or_implicit"; pseudo = false; };
    vmm = { terminator = false; control_flow = "fallthrough"; memory_effect = "none"; may_trap = false; atomic = false; serializing = false; privilege = "unknown"; helper_required = false; };
    disassembly = { mnemonic = "move_b"; syntax = "move.b ${rs1}, ${rd}"; encoding = "MOVE_B"; encoding_width = "16"; opcode = "unknown"; operand_order = ["rd", "rs1"]; };
    reverse_engineering = { category = "misc"; semantic_pattern = "move"; control_flow = "fallthrough"; memory_read = false; memory_write = false; branch_target = "none"; xref_kind = "data_or_none"; semantic_confidence = "derived_from_existing_spec"; };
  
    binary_translation = {
      schema_version = 1;
      semantic_source = "semantics";
      encoding_source = "encoding";
      operand_source = "operands";
      dataflow_source = "dataflow";
      control_flow = "fallthrough";
      terminates_block = false;
      branch_target = "none";
      memory_effect = "none";
      may_trap = false;
      atomic = false;
      serializing = false;
      privilege = "unknown";
      pc_effect = "derive_from_semantics_and_control_flow";
      implicit_register_effects = "derive_from_semantics";
      flag_effects = "derive_from_dataflow_and_semantics";
      target_lowering = "instruction_selection.pattern";
      equivalence_basis = "semantics";
    };
}
}

