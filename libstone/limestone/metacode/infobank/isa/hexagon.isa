arch hexagon { word_size = 32; addr_size = 32; endian = little; align = 4; }


profile {
  family = "Qualcomm_Hexagon";
  model = "Hexagon";
  version = "V5_plus_target_dependent";
  word_size = 32;
  address_size = 32;
  endianness = "little";
  instruction_encoding = "fixed32_packetized";
  execution_model = "VLIW_packet";
  register_model = "register";
  extensions = ["base_integer"];
  register_classes = ["GPR"];
  fixed_registers = [];
  zero_register = "none";
  operation_classes = ["arithmetic", "branch", "misc"];
  instruction_count = 26;
  encoding_widths = ["32"];
  coverage = "source_inventory";
  encoding_layout = { fixed_bits = "32"; packetized = true; };
}
compiler {
  instruction_selection {
    strategy = "pattern_matching_with_packetization";
    opcode_classes = ["arithmetic", "branch", "misc"];
    register_classes = ["GPR"];
    immediate_folding = true;
    addressing_mode_folding = false;
    branch_form_selection = true;
    pseudo_expansion = "target_dependent";
    cost_model = "target_microarchitecture";
  }
  instruction_scheduling {
    strategy = "VLIW_packet_scheduler";
    dependency_ordering = true;
    memory_dependence_analysis = false;
    control_dependence_analysis = true;
    latency_model = "target_microarchitecture";
    resource_model = "target_microarchitecture";
    packetization = true;
  }
  register_allocation {
    strategy = "target_register_allocation";
    register_classes = ["GPR"];
    fixed_registers = [];
    zero_register = "none";
    caller_saved = "abi_dependent";
    callee_saved = "abi_dependent";
    spill_policy = "target_dependent";
  }
  optimization {
    legality_model = "isa_and_memory_model";
    transforms = ["constant_folding", "copy_propagation", "dead_code_elimination", "common_subexpression_elimination", "peephole_rewrite", "branch_simplification", "load_store_motion_target_dependent", "strength_reduction_target_dependent", "branch_relaxation_target_dependent"];
    instruction_combining = true;
    peephole_optimization = true;
    constant_folding = true;
    dead_code_elimination = true;
    common_subexpression_elimination = true;
    loop_optimization = "target_dependent";
    vectorization = "target_dependent";
    if_conversion = "target_dependent";
    interprocedural_optimization = "abi_and_linkage_dependent";
  }
}
regclass GPR {
    r0(32)=0,
    r1(32)=1,
    r2(32)=2,
    r3(32)=3,
    r4(32)=4,
    r5(32)=5,
    r6(32)=6,
    r7(32)=7,
    r8(32)=8,
    r9(32)=9,
    r10(32)=10,
    r11(32)=11,
    r12(32)=12,
    r13(32)=13,
    r14(32)=14,
    r15(32)=15,
    r16(32)=16,
    r17(32)=17,
    r18(32)=18,
    r19(32)=19,
    r20(32)=20,
    r21(32)=21,
    r22(32)=22,
    r23(32)=23,
    r24(32)=24,
    r25(32)=25,
    r26(32)=26,
    r27(32)=27,
    r28(32)=28,
    r29(32)=29,
    r30(32)=30,
    r31(32)=31,
}

alias g0 = r4;
alias g1 = r5;
alias g2 = r6;

encoding ADD { width = 32;
  base = 0xf300c000;
  rd = 0:5;
  rs1 = 16:5;
  rs2 = 8:5;
}

op add { class = arithmetic; encoding = ADD;
  operands = rd: GPR, rs1: GPR, rs2: GPR;
  syntax = "{rd} = add({rs1}, {rs2})";
  semantics = "(set rd (add rs1 rs2))";

  tooling = {
    dataflow = { uses = ["rs1", "rs2"]; defs = ["rd"]; explicit_operands = ["rd", "rs1", "rs2"]; precision = "derived"; flags_read = false; flags_written = false; memory = "none"; control = "fallthrough"; };
    scheduling = { latency = "unknown"; reciprocal_throughput = "unknown"; resource_class = "integer"; resources = ["target_dependent"]; dependency_latency = "target_dependent"; issue_width = "target_dependent"; serializing = false; };
    register_allocation = { operand_constraints = ["rd:GPR", "rs1:GPR", "rs2:GPR"]; tied_operands = []; fixed_registers = []; clobbers = []; early_clobber = []; spillable = true; };
    instruction_selection = { pattern = "add"; opcode_class = "arithmetic"; commutative = true; immediate_folding = false; addressing_mode = "none_or_implicit"; pseudo = false; };
    vmm = { terminator = false; control_flow = "fallthrough"; memory_effect = "none"; may_trap = false; atomic = false; serializing = false; privilege = "unknown"; helper_required = false; };
    disassembly = { mnemonic = "add"; syntax = "{rd} = add({rs1}, {rs2})"; encoding = "ADD"; encoding_width = "32"; opcode = "unknown"; operand_order = ["rd", "rs1", "rs2"]; };
    reverse_engineering = { category = "arithmetic"; semantic_pattern = "add"; control_flow = "fallthrough"; memory_read = false; memory_write = false; branch_target = "none"; xref_kind = "data_or_none"; semantic_confidence = "derived_from_existing_spec"; };
  
    binary_translation = {
      schema_version = 1;
      semantic_source = "semantics";
      encoding_source = "encoding";
      operand_source = "operands";
      dataflow_source = "dataflow";
      control_flow = "fallthrough";
      terminates_block = false;
      branch_target = "none";
      memory_effect = "none";
      may_trap = false;
      atomic = false;
      serializing = false;
      privilege = "unknown";
      pc_effect = "derive_from_semantics_and_control_flow";
      implicit_register_effects = "derive_from_semantics";
      flag_effects = "derive_from_dataflow_and_semantics";
      target_lowering = "instruction_selection.pattern";
      equivalence_basis = "semantics";
    };
}
}

