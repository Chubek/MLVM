arch avr { word_size = 8; addr_size = 16; endian = little; align = 2; }


profile {
  family = "AVR";
  model = "AVR_Classic";
  version = "AVR8";
  word_size = 8;
  address_size = 16;
  endianness = "little";
  instruction_encoding = "fixed16_and_32";
  execution_model = "scalar";
  register_model = "register";
  extensions = ["AVR8"];
  register_classes = ["GPR"];
  fixed_registers = [];
  zero_register = "none";
  operation_classes = ["arithmetic", "branch", "compare", "load", "misc", "store"];
  instruction_count = 68;
  encoding_widths = ["16"];
  coverage = "source_inventory";
  encoding_layout = { base_word = "16"; extended_instructions = "32"; endian = "little"; };
}
compiler {
  instruction_selection {
    strategy = "target_pattern_matching";
    opcode_classes = ["arithmetic", "branch", "compare", "load", "misc", "store"];
    register_classes = ["GPR"];
    immediate_folding = true;
    addressing_mode_folding = true;
    branch_form_selection = true;
    pseudo_expansion = "target_dependent";
    cost_model = "target_microarchitecture";
  }
  instruction_scheduling {
    strategy = "dependency_aware_target_scheduler";
    dependency_ordering = true;
    memory_dependence_analysis = true;
    control_dependence_analysis = true;
    latency_model = "target_microarchitecture";
    resource_model = "target_microarchitecture";
    packetization = false;
  }
  register_allocation {
    strategy = "target_register_allocation";
    register_classes = ["GPR"];
    fixed_registers = [];
    zero_register = "none";
    caller_saved = "abi_dependent";
    callee_saved = "abi_dependent";
    spill_policy = "target_dependent";
  }
  optimization {
    legality_model = "isa_and_memory_model";
    transforms = ["constant_folding", "copy_propagation", "dead_code_elimination", "common_subexpression_elimination", "peephole_rewrite", "branch_simplification", "load_store_motion_target_dependent", "strength_reduction_target_dependent", "addressing_mode_folding", "branch_relaxation_target_dependent"];
    instruction_combining = true;
    peephole_optimization = true;
    constant_folding = true;
    dead_code_elimination = true;
    common_subexpression_elimination = true;
    loop_optimization = "target_dependent";
    vectorization = "target_dependent";
    if_conversion = "target_dependent";
    interprocedural_optimization = "abi_and_linkage_dependent";
  }
}
regclass GPR {
    r0(8)=0,
    r1(8)=1,
    r2(8)=2,
    r3(8)=3,
    r4(8)=4,
    r5(8)=5,
    r6(8)=6,
    r7(8)=7,
    r8(8)=8,
    r9(8)=9,
    r10(8)=10,
    r11(8)=11,
    r12(8)=12,
    r13(8)=13,
    r14(8)=14,
    r15(8)=15,
    r16(8)=16,
    r17(8)=17,
    r18(8)=18,
    r19(8)=19,
    r20(8)=20,
    r21(8)=21,
    r22(8)=22,
    r23(8)=23,
    r24(8)=24,
    r25(8)=25,
    r26(8)=26,
    r27(8)=27,
    r28(8)=28,
    r29(8)=29,
    r30(8)=30,
    r31(8)=31,
}

alias xl = r26;
alias xh = r27;
alias yl = r28;
alias yh = r29;
alias zl = r30;
alias zh = r31;
alias sp = r5;

encoding ADD { width = 16;
  base = 0xc00;
  rd[3:0] = 4:4;
  rd[4:4] = 8:1;
  rs1[3:0] = 0:4;
  rs1[4:4] = 9:1;
}

op add { class = arithmetic; encoding = ADD;
  operands = rd: GPR, rs1: GPR;
  syntax = "add {rd}, {rs1}";
  semantics = "(set rd (add rd rs1))";

  tooling = {
    dataflow = { uses = ["rs1"]; defs = ["rd"]; explicit_operands = ["rd", "rs1"]; precision = "derived"; flags_read = false; flags_written = false; memory = "none"; control = "fallthrough"; };
    scheduling = { latency = "unknown"; reciprocal_throughput = "unknown"; resource_class = "integer"; resources = ["target_dependent"]; dependency_latency = "target_dependent"; issue_width = "target_dependent"; serializing = false; };
    register_allocation = { operand_constraints = ["rd:GPR", "rs1:GPR"]; tied_operands = []; fixed_registers = []; clobbers = []; early_clobber = []; spillable = true; };
    instruction_selection = { pattern = "add"; opcode_class = "arithmetic"; commutative = true; immediate_folding = false; addressing_mode = "none_or_implicit"; pseudo = false; };
    vmm = { terminator = false; control_flow = "fallthrough"; memory_effect = "none"; may_trap = false; atomic = false; serializing = false; privilege = "unknown"; helper_required = false; };
    disassembly = { mnemonic = "add"; syntax = "add {rd}, {rs1}"; encoding = "ADD"; encoding_width = "16"; opcode = "unknown"; operand_order = ["rd", "rs1"]; };
    reverse_engineering = { category = "arithmetic"; semantic_pattern = "add"; control_flow = "fallthrough"; memory_read = false; memory_write = false; branch_target = "none"; xref_kind = "data_or_none"; semantic_confidence = "derived_from_existing_spec"; };
  
    binary_translation = {
      schema_version = 1;
      semantic_source = "semantics";
      encoding_source = "encoding";
      operand_source = "operands";
      dataflow_source = "dataflow";
      control_flow = "fallthrough";
      terminates_block = false;
      branch_target = "none";
      memory_effect = "none";
      may_trap = false;
      atomic = false;
      serializing = false;
      privilege = "unknown";
      pc_effect = "derive_from_semantics_and_control_flow";
      implicit_register_effects = "derive_from_semantics";
      flag_effects = "derive_from_dataflow_and_semantics";
      target_lowering = "instruction_selection.pattern";
      equivalence_basis = "semantics";
    };
}
}

