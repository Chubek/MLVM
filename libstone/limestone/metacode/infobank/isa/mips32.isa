      memory_effect = "write";
      may_trap = false;
      atomic = false;
      serializing = false;
      privilege = "unknown";
      pc_effect = "derive_from_semantics_and_control_flow";
      implicit_register_effects = "derive_from_semantics";
      flag_effects = "derive_from_dataflow_and_semantics";
      target_lowering = "instruction_selection.pattern";
      equivalence_basis = "semantics";
    };
}
}

encoding SDC1 { width = 32;
  base = 0xf4000000;
  rd = 16:5;
  rs1 = 21:5;
  offset = 0:16;
  signed = 1;
}

op sdc1 { class = store; encoding = SDC1;
  operands = rd: FPR, rs1: GPR, offset: imm;
  syntax = "sdc1 ${rd}, {offset}(${rs1})";
  semantics = "(store (memory-address rd offset) rs1)";

  tooling = {
    dataflow = { uses = ["rd", "rs1", "offset"]; defs = []; explicit_operands = ["rd", "rs1", "offset"]; precision = "derived"; flags_read = false; flags_written = false; memory = "write"; control = "fallthrough"; };
