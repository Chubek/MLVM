    vmm = { terminator = false; control_flow = "fallthrough"; memory_effect = "write"; may_trap = false; atomic = false; serializing = false; privilege = "unknown"; helper_required = false; };
    disassembly = { mnemonic = "sdc1"; syntax = "sdc1 ${rd}, {offset}(${rs1})"; encoding = "SDC1"; encoding_width = "32"; opcode = "unknown"; operand_order = ["rd", "rs1", "offset"]; };
    reverse_engineering = { category = "store"; semantic_pattern = "store"; control_flow = "fallthrough"; memory_read = false; memory_write = true; branch_target = "none"; xref_kind = "data_or_none"; semantic_confidence = "derived_from_existing_spec"; };
  
    binary_translation = {
      schema_version = 1;
      semantic_source = "semantics";
      encoding_source = "encoding";
      operand_source = "operands";
      dataflow_source = "dataflow";
      control_flow = "fallthrough";
      terminates_block = false;
      branch_target = "none";
      memory_effect = "write";
      may_trap = false;
      atomic = false;
      serializing = false;
      privilege = "unknown";
      pc_effect = "derive_from_semantics_and_control_flow";
      implicit_register_effects = "derive_from_semantics";
      flag_effects = "derive_from_dataflow_and_semantics";
