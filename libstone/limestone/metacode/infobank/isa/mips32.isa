# Tooling augmentation: declarative metadata for schedulers, register allocators,
# instruction selectors, VMM/code generators, disassemblers, and reverse-engineering tools.
# Values marked target_dependent/unknown are intentionally not guessed from an ISA-only source.
tooling {
  schema_version = 1;
  architecture = "mips32";
  scheduling = {
    execution_model = "scalar_target_dependent";
    issue_model = "target_dependent";
    dispatch_width = "unknown";
    issue_width = "unknown";
    retire_width = "unknown";
    reorder_buffer = "unknown";
    reservation_stations = "unknown";
    resource_model = "per_microarchitecture";
    pipeline_model = "per_microarchitecture";
    latency_model = "per_instruction_or_uarch";
    throughput_model = "per_instruction_or_uarch";
    bypass_model = "unknown";
    hazard_model = "data_and_memory_dependencies";
    packetization = false;
    scheduling_domains = ["register_dependencies", "memory_dependencies", "control_dependencies", "resource_conflicts"];
  };
  register_allocation = {
    register_model = "register";
    register_classes = ["GPR", "FPR"];
    fixed_registers = ["zero"];
    zero_register = "zero";
    aliasing = "derive_from_register_file";
    subregisters = "architecture_specific";
    register_banks = "architecture_specific";
    caller_saved = "abi_dependent";
    callee_saved = "abi_dependent";
    spill_slots = "stack_or_target_specific";
    rematerialization = "instruction_semantics_dependent";
    constraints = ["fixed_registers", "register_classes", "tied_operands", "implicit_operands", "early_clobber"];
  };
  instruction_selection = {
    opcode_classes = ["arithmetic", "branch", "compare", "load", "misc", "store"];
    selection_model = "semantic_pattern_plus_operand_constraints";
    patterns = "derive_from_op.semantics";
    immediate_constraints = "encoding_dependent";
    addressing_modes = "encoding_and_operand_dependent";
    commutativity = "semantic_pattern_dependent";
    canonical_forms = "target_dependent";
    pseudo_instructions = "encoding_or_semantics_dependent";
    legalization = ["immediate_range", "register_class", "addressing_mode", "alignment", "calling_convention"];
    cost_model = "target_microarchitecture";
  };
  vmm = {
    code_model = "instruction_semantics_plus_control_flow";
    block_formation = "terminator_and_fallthrough";
    memory_model = "isa_and_target_dependent";
    exception_model = "derive_from_semantics_and_profile";
    privilege_model = "unknown";
    atomic_model = "derive_from_instruction_class_and_semantics";
    barriers = "semantic_pattern_dependent";
    calling_convention = "abi_dependent";
    stack_model = "register_and_abi_dependent";
    helper_calls = "target_dependent";
    relocation_model = "encoding_and_object_format_dependent";
  };
  disassembler = {
    encoding_model = "fixed32";
    widths = ["32"];
    operand_decoding = "encoding_fields_plus_op.operands";
    syntax_model = "op.syntax";
    aliases = "target_specific";
    pseudo_rendering = "target_specific";
    branch_target_recovery = "encoding_and_pc_semantics";
    immediate_sign_extension = "encoding_dependent";
    endianness = "big";
  };
  reverse_engineering = {
    instruction_identity = ["encoding", "mnemonic", "operand_signature"];
    control_flow = "op.tooling.vmm.control_flow";
    data_flow = "op.tooling.dataflow";
    memory_access = "op.tooling.dataflow.memory";
    xrefs = ["code", "data", "branch_targets", "call_targets"];
    function_boundary_hints = ["call", "return", "branch", "stack_pointer_effect"];
    lifting = "op.semantics";
    equivalence = "semantic_s_expression";
    opaque_operations = "preserve_as_intrinsic";
    confidence = "derived_from_existing_spec";
  };

  bin2bin = {
    schema_version = 1;
    execution_domain = "native_machine_code";
    semantic_format = "s-expression";
    instruction_encoding = "fixed32";
    encoding_widths = ["32"];
    endianness = "big";
    word_size = 32;
    address_size = 32;
    instruction_boundary = "encoding_defined";
    instruction_identity = ["encoding", "mnemonic", "operand_signature"];
    operand_source = "op.operands";
    semantic_source = "op.semantics";
    dataflow_source = "op.tooling.dataflow";
    control_flow_source = "op.tooling.vmm";
    branch_target_source = "op.tooling.reverse_engineering";
    memory_effect_source = "op.tooling.dataflow_and_vmm";
    implicit_state_source = "op.semantics_and_architecture_state";
    relocation_model = "object_format_dependent";
    indirect_target_policy = "runtime_or_static_analysis_dependent";
    unknown_semantics_policy = "preserve_opaque_or_reject";
    unsupported_instruction_policy = "fail_closed";
    block_translation_unit = "basic_block_or_trace";
    equivalence_basis = "semantic_s_expression";
    cache_safe_when = ["source_identity", "source_architecture", "target_architecture", "translation_rules", "infobank_version", "translator_configuration"];
  };
}
