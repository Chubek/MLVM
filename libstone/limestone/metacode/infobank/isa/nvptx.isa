arch nvptx { word_size = 32; addr_size = 64; endian = little; align = 1; }


profile {
  family = "NVIDIA_PTX";
  model = "PTX";
  version = "virtual_ISA";
  word_size = 32;
  address_size = 64;
  endianness = "little";
  instruction_encoding = "textual_virtual_isa";
  execution_model = "SIMT";
  register_model = "virtual_typed_registers";
  extensions = ["PTX"];
  register_classes = ["GPR", "FPR"];
  fixed_registers = [];
  zero_register = "none";
  operation_classes = ["arithmetic", "branch", "compare", "misc"];
  instruction_count = 42;
  encoding_widths = ["text"];
  coverage = "source_inventory";
  encoding_layout = { representation = "PTX_text"; physical_encoding = "not_modeled"; };
}
compiler {
  instruction_selection {
    strategy = "typed_pattern_matching";
    opcode_classes = ["arithmetic", "branch", "compare", "misc"];
    register_classes = ["GPR", "FPR"];
    immediate_folding = true;
    addressing_mode_folding = false;
    branch_form_selection = true;
    pseudo_expansion = "target_dependent";
    cost_model = "target_microarchitecture";
  }
  instruction_scheduling {
    strategy = "SIMT_latency_hiding_scheduler";
    dependency_ordering = true;
    memory_dependence_analysis = false;
    control_dependence_analysis = true;
    latency_model = "target_microarchitecture";
    resource_model = "target_microarchitecture";
    packetization = false;
  }
  register_allocation {
    strategy = "typed_virtual_register_allocation";
    register_classes = ["GPR", "FPR"];
    fixed_registers = [];
    zero_register = "none";
    caller_saved = "abi_dependent";
    callee_saved = "abi_dependent";
    spill_policy = "target_dependent";
  }
  optimization {
    legality_model = "isa_and_memory_model";
    transforms = ["constant_folding", "copy_propagation", "dead_code_elimination", "common_subexpression_elimination", "peephole_rewrite", "branch_simplification", "load_store_motion_target_dependent", "strength_reduction_target_dependent", "branch_relaxation_target_dependent"];
    instruction_combining = true;
    peephole_optimization = true;
    constant_folding = true;
    dead_code_elimination = true;
    common_subexpression_elimination = true;
    loop_optimization = "target_dependent";
    vectorization = "target_dependent";
    if_conversion = "target_dependent";
    interprocedural_optimization = "abi_and_linkage_dependent";
  }
}
regclass GPR {
    r0(32)=0,
    r1(32)=1,
    r2(32)=2,
    r3(32)=3,
    r4(32)=4,
    r5(32)=5,
    r6(32)=6,
    r7(32)=7,
    r8(32)=8,
    r9(32)=9,
    r10(32)=10,
    r11(32)=11,
    r12(32)=12,
    r13(32)=13,
    r14(32)=14,
    r15(32)=15,
    rd0(64)=16,
    rd1(64)=17,
    rd2(64)=18,
    rd3(64)=19,
    rd4(64)=20,
    rd5(64)=21,
    rd6(64)=22,
    rd7(64)=23,
}

regclass FPR {
    f0(32)=0,
    f1(32)=1,
    f2(32)=2,
    f3(32)=3,
    f4(32)=4,
    f5(32)=5,
    f6(32)=6,
    f7(32)=7,
    f8(32)=8,
    f9(32)=9,
    f10(32)=10,
    f11(32)=11,
    f12(32)=12,
    f13(32)=13,
    f14(32)=14,
    f15(32)=15,
    fd0(64)=16,
    fd1(64)=17,
    fd2(64)=18,
    fd3(64)=19,
    fd4(64)=20,
    fd5(64)=21,
    fd6(64)=22,
    fd7(64)=23,
}

encoding ADD_U32 { width = text; }
op add_u32 { class = arithmetic; encoding = ADD_U32; operands = rd: GPR, rs1: GPR, rs2: GPR; syntax = "add.u32 %{rd}, %{rs1}, %{rs2};";
  semantics = "(set rd (add rs1 rs2))";

  tooling = {
    dataflow = { uses = ["rs1", "rs2"]; defs = ["rd"]; explicit_operands = ["rd", "rs1", "rs2"]; precision = "derived"; flags_read = false; flags_written = false; memory = "none"; control = "fallthrough"; };
