@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@LIMESTONE_ENABLE_PERSISTENT_CACHE@ AND NOT TARGET Limestone::lmdb)
  find_library(Limestone_LMDB_LIBRARY NAMES lmdb REQUIRED)
  add_library(Limestone::lmdb UNKNOWN IMPORTED)
  set_target_properties(Limestone::lmdb PROPERTIES IMPORTED_LOCATION "${Limestone_LMDB_LIBRARY}")
endif()
if(@LIMESTONE_ENABLE_NATIVE_FFI@ AND NOT TARGET Limestone::native_ffi)
  find_library(Limestone_FFI_LIBRARY NAMES ffi REQUIRED)
  add_library(Limestone::native_ffi UNKNOWN IMPORTED)
  set_target_properties(Limestone::native_ffi PROPERTIES IMPORTED_LOCATION "${Limestone_FFI_LIBRARY}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/LimestoneTargets.cmake")
set(Limestone_NATIVE_FFI @LIMESTONE_ENABLE_NATIVE_FFI@)
set(Limestone_PERSISTENT_CACHE @LIMESTONE_ENABLE_PERSISTENT_CACHE@)
foreach(component IN LISTS Limestone_FIND_COMPONENTS)
  if(TARGET Limestone::${component})
    set(Limestone_${component}_FOUND TRUE)
  else()
    set(Limestone_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(Limestone)
