-- amd64.dsymspec — AMD64 / x86-64, SysV AMD64 ABI.
-- Two syntaxes share one encoding: "intel" (default) and "att" (reversed).
-- Data: TableGen X86RegisterInfo.td (GR64/GR32/GR16/GR8 incl. R16-R31,
-- FR32/VR128/VR256/VR512, RFLAGS/RIP) + X86.td features (SSE2..AVX512, FMA,
-- BMI2, AES, POPCNT, SHA, RDRAND...), cross-checked via tablegen_inquiry +
-- arch_oracle + isa_reference AMD64 quick spec (System V vs Microsoft x64
-- arg regs, callee/caller-saved sets, ModR/M+SIB+disp+imm encoding).
-- Operand names: dst, src, imm, sym.
-- Strata: base | bmi/popcnt | sse/avx/fma | aes/sha | rdrnd | x87 | priv.
local symas = require("dsl").new()

symas.target{
    arch = "amd64", subarch = "x86-64",
    addr_size = 64, op_size = 32, addr_def = 64, align = 1,
    byte_order = "little", obj_format = "ELF64", abi = "SysV",
    calling_conv = "sysv-amd64",
    features = { "base", "sse", "sse2" },
}

symas.feature{ name = "base", desc = "x86-64 base integer" }
symas.feature{ name = "sse", desc = "Streaming SIMD Extensions" }
symas.feature{ name = "sse2", desc = "SSE2" }
symas.feature{ name = "sse3", desc = "SSE3" }
symas.feature{ name = "ssse3", desc = "SSSE3" }
symas.feature{ name = "sse4.1", desc = "SSE4.1" }
symas.feature{ name = "sse4.2", desc = "SSE4.2" }
symas.feature{ name = "avx", desc = "Advanced Vector Extensions" }
symas.feature{ name = "avx2", desc = "AVX2" }
symas.feature{ name = "avx512", desc = "AVX-512" }
symas.feature{ name = "fma", desc = "FMA3" }
symas.feature{ name = "bmi1", desc = "Bit Manipulation Instruction Set 1" }
symas.feature{ name = "bmi2", desc = "Bit Manipulation Instruction Set 2" }
symas.feature{ name = "aes", desc = "AES-NI" }
symas.feature{ name = "vaes", desc = "vector AES" }
symas.feature{ name = "pclmulqdq", desc = "carry-less multiply" }
symas.feature{ name = "popcnt", desc = "POPCNT" }
symas.feature{ name = "lzcnt", desc = "LZCNT" }
symas.feature{ name = "movbe", desc = "MOVBE" }
symas.feature{ name = "rdrnd", desc = "RDRAND" }
symas.feature{ name = "rdseed", desc = "RDSEED" }
symas.feature{ name = "sha", desc = "SHA extensions" }
symas.feature{ name = "gfni", desc = "Galois Field New Instructions" }
symas.feature{ name = "fsgsbase", desc = "FSGSBASE" }
symas.feature{ name = "adx", desc = "ADX multi-precision add" }
symas.feature{ name = "rdpid", desc = "RDPID" }
symas.feature{ name = "clflushopt", desc = "CLFLUSHOPT" }
symas.feature{ name = "clwb", desc = "CLWB" }
symas.feature{ name = "x87", desc = "x87 floating point stack" }
symas.feature{ name = "mmx", desc = "MMX" }
symas.feature{ name = "cet", desc = "Control-flow Enforcement (SHSTK+IBT)" }
symas.feature{ name = "rtm", desc = "Restricted Transactional Memory" }
symas.feature{ name = "sgx", desc = "Software Guard Extensions" }
symas.feature{ name = "serialize", desc = "SERIALIZE" }
symas.feature{ name = "uintr", desc = "user interrupts" }
symas.feature{ name = "cldemote", desc = "cache line demote" }
symas.feature{ name = "movdiri", desc = "MOVDIRI direct store" }
symas.feature{ name = "waitpkg", desc = "UMONITOR/UMWAIT/TPAUSE" }
symas.feature{ name = "clzero", desc = "CLZERO" }
symas.feature{ name = "priv", desc = "privileged system instructions" }

-- 64-bit GPRs (TableGen GR64 incl. R16-R31 APX extension regs).
local gpr64 = { "rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi" }
local gpr32 = { "eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi" }
local gpr16 = { "ax", "cx", "dx", "bx", "sp", "bp", "si", "di" }
local gpr8  = { "al", "cl", "dl", "bl", "spl", "bpl", "sil", "dil" }
for i = 0, 7 do
    local r = gpr64[i + 1]
    symas.register{ name = r, class = "gpr", width = 64, enc = i, flags = { "readable", "writable" } }
    symas.register{ name = gpr32[i + 1], class = "gpr", width = 32, enc = i, parent = r,
                    sub_lo = 0, sub_hi = 32, flags = { "readable", "writable" } }
    symas.register{ name = gpr16[i + 1], class = "gpr", width = 16, enc = i, parent = gpr32[i + 1],
                    sub_lo = 0, sub_hi = 16, flags = { "readable", "writable" } }
    symas.register{ name = gpr8[i + 1], class = "gpr", width = 8, enc = i, parent = gpr32[i + 1],
                    sub_lo = 0, sub_hi = 8, flags = { "readable", "writable" } }
end
for i = 8, 15 do
    symas.register{ name = "r" .. i, class = "gpr", width = 64, enc = i, flags = { "readable", "writable" } }
    symas.register{ name = "r" .. i .. "d", class = "gpr", width = 32, enc = i,
                    parent = "r" .. i, sub_lo = 0, sub_hi = 32, flags = { "readable", "writable" } }
    symas.register{ name = "r" .. i .. "w", class = "gpr", width = 16, enc = i,
                    parent = "r" .. i .. "d", sub_lo = 0, sub_hi = 16, flags = { "readable", "writable" } }
    symas.register{ name = "r" .. i .. "b", class = "gpr", width = 8, enc = i,
                    parent = "r" .. i .. "d", sub_lo = 0, sub_hi = 8, flags = { "readable", "writable" } }
end
symas.register{ name = "ah", class = "gpr", width = 8, enc = 4, parent = "eax", sub_lo = 8, sub_hi = 16 }
symas.register{ name = "bh", class = "gpr", width = 8, enc = 7, parent = "ebx", sub_lo = 8, sub_hi = 16 }
symas.register{ name = "ch", class = "gpr", width = 8, enc = 5, parent = "ecx", sub_lo = 8, sub_hi = 16 }
symas.register{ name = "dh", class = "gpr", width = 8, enc = 6, parent = "edx", sub_lo = 8, sub_hi = 16 }
-- Vector: XMM (128) / YMM (256) / ZMM (512), subregister-chained.
for i = 0, 31 do
    symas.register{ name = "zmm" .. i, class = "vec", width = 512, enc = i, flags = { "readable", "writable" } }
end
for i = 0, 31 do
    symas.register{ name = "ymm" .. i, class = "vec", width = 256, enc = i, parent = "zmm" .. i,
                    sub_lo = 0, sub_hi = 256, flags = { "readable", "writable" } }
end
for i = 0, 31 do
    symas.register{ name = "xmm" .. i, class = "vec", width = 128, enc = i, parent = "ymm" .. i,
                    sub_lo = 0, sub_hi = 128, flags = { "readable", "writable" } }
end
-- Opmask k0..k7.
for i = 0, 7 do
    symas.register{ name = "k" .. i, class = "mask", width = 64, enc = i, flags = { "readable", "writable" } }
end
-- x87 stack + MMX.
for i = 0, 7 do
    symas.register{ name = "st" .. i, class = "fp", width = 80, enc = i, flags = { "readable", "writable" } }
end
for i = 0, 7 do
    symas.register{ name = "mm" .. i, class = "vec", width = 64, enc = i, flags = { "readable", "writable" } }
end
symas.register{ name = "rip", class = "special", width = 64, enc = 0 }
symas.register{ name = "eip", class = "special", width = 32, enc = 0, parent = "rip", sub_lo = 0, sub_hi = 32 }
symas.register{ name = "rflags", class = "status", width = 64, enc = 0 }
symas.register{ name = "eflags", class = "status", width = 32, enc = 0, parent = "rflags", sub_lo = 0, sub_hi = 32 }
for _, s in ipairs({ "cs", "ss", "ds", "es", "fs", "gs" }) do
    symas.register{ name = s, class = "seg", width = 16, enc = 0 }
end
for _, c in ipairs({ "cr0", "cr2", "cr3", "cr4", "cr8" }) do
    symas.register{ name = c, class = "ctrl", width = 64, enc = 0, flags = { "modedep" } }
end
for i = 0, 7 do
    symas.register{ name = "dr" .. i, class = "debug", width = 64, enc = i, flags = { "modedep" } }
end

-- Legacy/REX.W encodings. emit_modrm(dst,src) -> mod=11 reg=dst rm=src.
symas.encoder{ name = "nop",   source = "emit8(0x90);", max_bytes = 1 }
symas.encoder{ name = "ret",   source = "emit8(0xC3);", max_bytes = 1 }
symas.encoder{ name = "mov",   source = "emit8(0x48); emit8(0x89); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "movimm", source = "emit8(0x48); emit8(0xB8 + dst); emit_imm(8, imm);", max_bytes = 10 }
symas.encoder{ name = "movzx", source = "emit8(0x48); emit8(0x0F); emit8(0xB7); emit_modrm(src, dst);", max_bytes = 4 }
symas.encoder{ name = "movsx", source = "emit8(0x48); emit8(0x0F); emit8(0xBF); emit_modrm(src, dst);", max_bytes = 4 }
symas.encoder{ name = "xchg",  source = "emit8(0x48); emit8(0x87); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "lea",   source = "emit8(0x48); emit8(0x8D); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "add",   source = "emit8(0x48); emit8(0x01); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "sub",   source = "emit8(0x48); emit8(0x29); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "and",   source = "emit8(0x48); emit8(0x21); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "or",    source = "emit8(0x48); emit8(0x09); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "xor",   source = "emit8(0x48); emit8(0x31); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "adc",   source = "emit8(0x48); emit8(0x11); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "sbb",   source = "emit8(0x48); emit8(0x19); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "cmp",   source = "emit8(0x48); emit8(0x39); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "test",  source = "emit8(0x48); emit8(0x85); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "inc",   source = "emit8(0x48); emit8(0xFF); emit_modrm(0, dst);", max_bytes = 3 }
symas.encoder{ name = "dec",   source = "emit8(0x48); emit8(0xFF); emit_modrm(1, dst);", max_bytes = 3 }
symas.encoder{ name = "neg",   source = "emit8(0x48); emit8(0xF7); emit_modrm(3, dst);", max_bytes = 3 }
symas.encoder{ name = "not",   source = "emit8(0x48); emit8(0xF7); emit_modrm(2, dst);", max_bytes = 3 }
symas.encoder{ name = "imul",  source = "emit8(0x48); emit8(0x0F); emit8(0xAF); emit_modrm(src, dst);", max_bytes = 4 }
symas.encoder{ name = "div",   source = "emit8(0x48); emit8(0xF7); emit_modrm(6, src);", max_bytes = 3 }
symas.encoder{ name = "idiv",  source = "emit8(0x48); emit8(0xF7); emit_modrm(7, src);", max_bytes = 3 }
symas.encoder{ name = "shl",   source = "emit8(0x48); emit8(0xD3); emit_modrm(4, dst);", max_bytes = 3 }
symas.encoder{ name = "shr",   source = "emit8(0x48); emit8(0xD3); emit_modrm(5, dst);", max_bytes = 3 }
symas.encoder{ name = "sar",   source = "emit8(0x48); emit8(0xD3); emit_modrm(7, dst);", max_bytes = 3 }
symas.encoder{ name = "andn",  source = "emit8(0xC4); emit8(0xE2); emit8(0xF0); emit_modrm(src, dst); emit8(0xC0 + src2);", max_bytes = 5 }
symas.encoder{ name = "popcnt", source = "emit8(0xF3); emit8(0x48); emit8(0x0F); emit8(0xB8); emit_modrm(src, dst);", max_bytes = 5 }
symas.encoder{ name = "tzcnt", source = "emit8(0xF3); emit8(0x48); emit8(0x0F); emit8(0xBC); emit_modrm(src, dst);", max_bytes = 5 }
symas.encoder{ name = "push",  source = "emit8(0x50 + dst);", max_bytes = 1 }
symas.encoder{ name = "pop",   source = "emit8(0x58 + dst);", max_bytes = 1 }
symas.encoder{ name = "pushf", source = "emit8(0x9C);", max_bytes = 1 }
symas.encoder{ name = "popf",  source = "emit8(0x9D);", max_bytes = 1 }
symas.encoder{ name = "call",  source = "emit8(0xE8); emit_imm(4, 0); emit_relocation(sym, R_X86_64_PLT32);", max_bytes = 5, max_relocs = 1 }
symas.encoder{ name = "jmp",   source = "emit8(0xE9); emit_imm(4, 0); emit_relocation(sym, R_X86_64_PLT32);", max_bytes = 5, max_relocs = 1 }
symas.encoder{ name = "jcc",   source = "emit8(0x0F); emit8(0x80 + cond); emit_imm(4, 0); emit_relocation(sym, R_X86_64_PC32);", max_bytes = 6, max_relocs = 1 }
symas.encoder{ name = "leave", source = "emit8(0xC9);", max_bytes = 1 }
symas.encoder{ name = "syscall", source = "emit8(0x0F); emit8(0x05);", max_bytes = 2 }
symas.encoder{ name = "int",   source = "emit8(0xCD); emit8(imm);", max_bytes = 2 }
symas.encoder{ name = "cpuid", source = "emit8(0x0F); emit8(0xA2);", max_bytes = 2 }
symas.encoder{ name = "movaps", source = "emit8(0x0F); emit8(0x28); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "addps", source = "emit8(0x0F); emit8(0x58); emit_modrm(src, dst);", max_bytes = 3 }
symas.encoder{ name = "vaddps", source = "emit8(0xC5); emit8(0xF8); emit8(0x58); emit_modrm(src, dst); emit8(0xC0 + src2);", max_bytes = 5 }
symas.encoder{ name = "vfmadd", source = "emit8(0xC4); emit8(0xE2); emit8(0x78); emit8(0x98); emit_modrm(src, dst); emit8(0xC0 + src2);", max_bytes = 6 }
symas.encoder{ name = "aesenc", source = "emit8(0x66); emit8(0x0F); emit8(0x38); emit8(0xDC); emit_modrm(src, dst);", max_bytes = 5 }
symas.encoder{ name = "fld",   source = "emit8(0xD9); emit8(0x00 + dst);", max_bytes = 2 }
symas.encoder{ name = "fadd",  source = "emit8(0xD8); emit8(0xC0 + dst);", max_bytes = 2 }
symas.encoder{ name = "rdrnd", source = "emit8(0x48); emit8(0x0F); emit8(0xC7); emit_modrm(6, dst);", max_bytes = 4 }
symas.encoder{ name = "cli",   source = "emit8(0xFA);", max_bytes = 1 }
symas.encoder{ name = "sti",   source = "emit8(0xFB);", max_bytes = 1 }
symas.encoder{ name = "hlt",   source = "emit8(0xF4);", max_bytes = 1 }
symas.encoder{ name = "pause", source = "emit8(0xF3); emit8(0x90);", max_bytes = 2 }

local function r64() return { kind = "reg", class = "gpr", width = 64 } end
local function w64() return { kind = "reg", class = "gpr", width = 64, access = "write" } end
local function rw64() return { kind = "reg", class = "gpr", width = 64, access = "readwrite" } end
local function xv() return { kind = "reg", class = "vec", width = 128 } end
local function wxv() return { kind = "reg", class = "vec", width = 128, access = "write" } end

for _, m in ipairs({ "nop", "ret", "mov", "movabs", "movzx", "movsx", "xchg",
    "lea", "add", "sub", "and", "or", "xor", "adc", "sbb", "cmp", "test",
    "inc", "dec", "neg", "not", "imul", "div", "idiv", "shl", "shr", "sar",
    "andn", "popcnt", "tzcnt", "push", "pop", "pushf", "popf", "call", "jmp",
    "jcc", "leave", "syscall", "int", "cpuid", "movaps", "addps", "vaddps",
    "vfmadd", "aesenc", "fld", "fadd", "rdrnd", "cli", "sti", "hlt", "pause" }) do
    symas.mnemonic{ name = m }
end
symas.form{ mnemonic = "nop", encoder = "nop" }
symas.form{ mnemonic = "ret", encoder = "ret", flags = { "return", "terminator" } }
symas.form{ mnemonic = "mov", encoder = "mov", operands = { w64(), r64() } }
symas.form{ mnemonic = "movabs", encoder = "movimm", operands = { w64(),
    { kind = "imm", width = 64, signed = true, imm_min = -9223372036854775807, imm_max = 9223372036854775807 } } }
symas.form{ mnemonic = "movzx", encoder = "movzx", operands = { w64(), { kind = "reg", class = "gpr", width = 32 } } }
symas.form{ mnemonic = "movsx", encoder = "movsx", operands = { w64(), { kind = "reg", class = "gpr", width = 32 } } }
symas.form{ mnemonic = "xchg", encoder = "xchg", operands = { rw64(), r64() } }
symas.form{ mnemonic = "lea", encoder = "lea", operands = { w64(), { kind = "mem", width = 64 } } }
symas.form{ mnemonic = "add", encoder = "add", operands = { rw64(), r64() } }
symas.form{ mnemonic = "sub", encoder = "sub", operands = { rw64(), r64() } }
symas.form{ mnemonic = "and", encoder = "and", operands = { rw64(), r64() } }
symas.form{ mnemonic = "or",  encoder = "or",  operands = { rw64(), r64() } }
symas.form{ mnemonic = "xor", encoder = "xor", operands = { rw64(), r64() } }
symas.form{ mnemonic = "adc", encoder = "adc", operands = { rw64(), r64() } }
symas.form{ mnemonic = "sbb", encoder = "sbb", operands = { rw64(), r64() } }
symas.form{ mnemonic = "cmp", encoder = "cmp", operands = { r64(), r64() } }
symas.form{ mnemonic = "test", encoder = "test", operands = { r64(), r64() } }
symas.form{ mnemonic = "inc", encoder = "inc", operands = { rw64() } }
symas.form{ mnemonic = "dec", encoder = "dec", operands = { rw64() } }
symas.form{ mnemonic = "neg", encoder = "neg", operands = { rw64() } }
symas.form{ mnemonic = "not", encoder = "not", operands = { rw64() } }
symas.form{ mnemonic = "imul", encoder = "imul", operands = { w64(), r64() } }
symas.form{ mnemonic = "div", encoder = "div", flags = { "may_trap" }, operands = { r64() } }
symas.form{ mnemonic = "idiv", encoder = "idiv", flags = { "may_trap" }, operands = { r64() } }
symas.form{ mnemonic = "shl", encoder = "shl", operands = { rw64(), r64() } }
symas.form{ mnemonic = "shr", encoder = "shr", operands = { rw64(), r64() } }
symas.form{ mnemonic = "sar", encoder = "sar", operands = { rw64(), r64() } }
symas.form{ mnemonic = "andn", encoder = "andn", required = { "bmi1" }, operands = { w64(), r64(), r64() } }
symas.form{ mnemonic = "popcnt", encoder = "popcnt", required = { "popcnt" }, operands = { w64(), r64() } }
symas.form{ mnemonic = "tzcnt", encoder = "tzcnt", required = { "lzcnt" }, operands = { w64(), r64() } }
symas.form{ mnemonic = "push", encoder = "push", operands = { r64() } }
symas.form{ mnemonic = "pop",  encoder = "pop",  operands = { w64() } }
symas.form{ mnemonic = "pushf", encoder = "pushf" }
symas.form{ mnemonic = "popf", encoder = "popf" }
symas.form{ mnemonic = "call", encoder = "call", flags = { "branch", "reloc" }, operands = { { kind = "sym", width = 64 } } }
symas.form{ mnemonic = "jmp", encoder = "jmp", flags = { "branch", "terminator", "reloc" }, operands = { { kind = "sym", width = 64 } } }
symas.form{ mnemonic = "jcc", encoder = "jcc", flags = { "cond_branch", "reloc" },
    operands = { { kind = "cond", width = 8 }, { kind = "sym", width = 64 } } }
symas.form{ mnemonic = "leave", encoder = "leave" }
symas.form{ mnemonic = "syscall", encoder = "syscall", flags = { "privileged", "may_trap" } }
symas.form{ mnemonic = "int", encoder = "int", flags = { "may_trap" }, operands = {
    { kind = "imm", width = 8, signed = false, imm_min = 0, imm_max = 255 } } }
symas.form{ mnemonic = "cpuid", encoder = "cpuid" }
symas.form{ mnemonic = "movaps", encoder = "movaps", required = { "sse" }, operands = { wxv(), xv() } }
symas.form{ mnemonic = "addps", encoder = "addps", required = { "sse" }, operands = { wxv(), xv() } }
symas.form{ mnemonic = "vaddps", encoder = "vaddps", required = { "avx" },
    operands = { wxv(), xv(), xv() } }
symas.form{ mnemonic = "vfmadd", encoder = "vfmadd", required = { "fma" },
    operands = { wxv(), xv(), xv() } }
symas.form{ mnemonic = "aesenc", encoder = "aesenc", required = { "aes" }, operands = { wxv(), xv() } }
symas.form{ mnemonic = "fld", encoder = "fld", required = { "x87" }, operands = { { kind = "mem", width = 80 } } }
symas.form{ mnemonic = "fadd", encoder = "fadd", required = { "x87" }, operands = {
    { kind = "reg", class = "fp", width = 80, access = "readwrite" } } }
symas.form{ mnemonic = "rdrnd", encoder = "rdrnd", required = { "rdrnd" }, operands = { w64() } }
symas.form{ mnemonic = "cli", encoder = "cli", required = { "priv" }, flags = { "privileged" } }
symas.form{ mnemonic = "sti", encoder = "sti", required = { "priv" }, flags = { "privileged" } }
symas.form{ mnemonic = "hlt", encoder = "hlt", required = { "priv" }, flags = { "privileged" } }
symas.form{ mnemonic = "pause", encoder = "pause" }

symas.syntax{ name = "intel", comment = ";", separator = ", " }
symas.syntax{ name = "att", order = 1, reg_prefix = "%", imm_prefix = "$", comment = "#", separator = ", " }

symas.section{ name = ".text", flags = { "exec", "alloc", "code" }, align = 16, content = "code" }
symas.section{ name = ".rodata", flags = { "alloc", "readonly", "data" }, align = 8, content = "data" }
symas.section{ name = ".data", flags = { "write", "alloc", "data" }, align = 8, content = "data" }
symas.section{ name = ".bss", flags = { "write", "alloc", "zerofill", "data" }, align = 8, content = "data" }
symas.section{ name = ".tdata", flags = { "write", "alloc", "tls", "data" }, align = 8, content = "data" }
symas.section{ name = ".tbss", flags = { "write", "alloc", "zerofill", "tls", "data" }, align = 8, content = "data" }
symas.section{ name = ".init", flags = { "exec", "alloc", "code" }, align = 16, content = "code" }
symas.section{ name = ".fini", flags = { "exec", "alloc", "code" }, align = 16, content = "code" }
symas.section{ name = ".plt", flags = { "exec", "alloc", "code" }, align = 16, content = "code" }
symas.section{ name = ".got", flags = { "write", "alloc", "data" }, align = 8, content = "data" }
symas.section{ name = ".eh_frame", flags = { "alloc", "readonly", "data" }, align = 8, content = "data" }
symas.section{ name = ".comment", flags = { "merge", "readonly", "meta" }, align = 1, content = "meta" }

symas.linkage{ name = "func_global", binding = "global", visibility = "default", symtype = "func" }
symas.linkage{ name = "func_weak", binding = "weak", visibility = "default", symtype = "func" }
symas.linkage{ name = "object_global", binding = "global", visibility = "default", symtype = "object" }
symas.linkage{ name = "tls_var", binding = "tls", visibility = "default", symtype = "object" }
symas.linkage{ name = "local_sym", binding = "local", visibility = "default", symtype = "none" }
symas.linkage{ name = "hidden_func", binding = "global", visibility = "hidden", symtype = "func" }

symas.reloc{ name = "R_X86_64_NONE", width = 64, expr = "S + A" }
symas.reloc{ name = "R_X86_64_64", width = 64, expr = "S + A" }
symas.reloc{ name = "R_X86_64_32", width = 32, expr = "S + A" }
symas.reloc{ name = "R_X86_64_32S", width = 32, signed = true, expr = "S + A" }
symas.reloc{ name = "R_X86_64_16", width = 32, expr = "S + A" }
symas.reloc{ name = "R_X86_64_8", width = 32, expr = "S + A" }
symas.reloc{ name = "R_X86_64_PC8", width = 32, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_X86_64_PC16", width = 32, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_X86_64_PC32", width = 32, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_X86_64_PC64", width = 64, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_X86_64_PLT32", width = 32, signed = true, pcrel = true, expr = "PLT(S) + A - P" }
symas.reloc{ name = "R_X86_64_PLTOFF64", width = 64, expr = "PLT(S) + A" }
symas.reloc{ name = "R_X86_64_GOT32", width = 32, expr = "GOT(S) + A" }
symas.reloc{ name = "R_X86_64_GOTPCREL", width = 32, signed = true, pcrel = true, expr = "GOT(S) + A - P" }
symas.reloc{ name = "R_X86_64_GOTPCRELX", width = 32, signed = true, pcrel = true, expr = "GOT(S) + A - P" }
symas.reloc{ name = "R_X86_64_REX_GOTPCRELX", width = 32, signed = true, pcrel = true, expr = "GOT(S) + A - P" }
symas.reloc{ name = "R_X86_64_TLSGD", width = 32, signed = true, pcrel = true, expr = "TLS(S) + A - P" }
symas.reloc{ name = "R_X86_64_TLSLD", width = 32, signed = true, pcrel = true, expr = "TLS(S) + A - P" }
symas.reloc{ name = "R_X86_64_TPOFF32", width = 32, expr = "TLS(S) + A" }
symas.reloc{ name = "R_X86_64_DTPOFF32", width = 32, expr = "TLS(S) + A" }
symas.reloc{ name = "R_X86_64_GOTTPOFF", width = 32, signed = true, pcrel = true, expr = "TLS(S) + A - P" }
symas.reloc{ name = "R_X86_64_RELATIVE", width = 64, expr = "B + A" }
symas.reloc{ name = "R_X86_64_IRELATIVE", width = 64, expr = "B + A" }
symas.reloc{ name = "R_X86_64_GLOB_DAT", width = 64, expr = "S + A" }
symas.reloc{ name = "R_X86_64_JUMP_SLOT", width = 64, expr = "S + A" }
symas.reloc{ name = "R_X86_64_COPY", width = 64, expr = "S" }

symas.debug{ msg = "x86-64 base + bmi + sse/avx/fma + aes + x87 + priv", kind = "target", ref = "" }
symas.debug{ msg = "vector forms require sse/avx/fma", kind = "form", ref = "vaddps" }
symas.debug{ msg = "privileged forms require priv", kind = "form", ref = "cli" }

-- ---------------------------------------------------------------------------
-- Instruction selection, scheduling, and per-model optimization
-- ---------------------------------------------------------------------------
-- Sources (all cross-checked with the tablegen_inquiry MCP tool, which reads
-- the same files under $TABLEGEN_LIB):
--   X86/X86Schedule.td          GenericX86Model / GenericModel, WriteALU,
--                               WriteIMul*, WriteIDiv*, WriteLoad/WriteStore,
--                               WriteJump, WriteCMOV, WriteShift, WriteRMW
--   X86/X86SchedSkylakeClient.td SkylakeClientModel (6-wide, ROB 224, LoadLat 5,
--                               Mispredict 14, LoopMOB 50) + SKLPort0..7,
--                               SKLDivider, SKLWriteResPair/X86WriteRes tables
--   X86/X86SchedBroadwell.td    BroadwellModel (4-wide, ROB 192, mispredict 16)
--   X86/X86ScheduleAtom.td      AtomModel (2-wide in-order, post-RA scheduler)
--   X86/X86.td                  ProcModel<"skylake", ...> and the Tuning*
--                               subtarget features (TuningMacroFusion,
--                               TuningSlow3OpsLEA, TuningSlowDivide64, ...)
--   ccbe_oracle                 x86 compare+branch macro-fusion, cmov vs branch
--                               chains, LEA formation, xchg elimination.
--
-- The base SCHED table is the Skylake-client register-form latency table
-- (X86SchedSkylakeClient.td: SKLWriteResPair/X86WriteRes `Lat`/`UOps`); the
-- other models override it through TUNING records.

-- Tuning knobs modelled as features (X86.td `def Tuning*`).
symas.feature{ name = "macrofusion", desc = "TuningMacroFusion: fuse cmp/test with jcc" }
symas.feature{ name = "branchfusion", desc = "TuningBranchFusion: fuse jumps with the next instruction" }
symas.feature{ name = "slow3opslea", desc = "TuningSlow3OpsLEA: 3-operand LEA costs an extra uop" }
symas.feature{ name = "slowdivide64", desc = "TuningSlowDivide64: 64-bit division is expensive" }
symas.feature{ name = "slowincdec", desc = "TuningSlowIncDec: read-modify-write inc/dec" }
symas.feature{ name = "slowuamem32", desc = "TuningSlowUAMem32: unaligned 32-bit memory access" }
symas.feature{ name = "popcntfalsedeps", desc = "TuningPOPCNTFalseDeps: break popcnt false dependencies" }
symas.feature{ name = "lzcntfalsedeps", desc = "TuningLZCNTFalseDeps: break lzcnt/tzcnt false dependencies" }
symas.feature{ name = "fastshldrotate", desc = "TuningFastSHLDRotate: shld/shrd with %cl is cheap" }
symas.feature{ name = "fastscalarfsqrt", desc = "TuningFastScalarFSQRT: scalar sqrt uses a fast path" }
symas.feature{ name = "insertvzeroupper", desc = "TuningInsertVZEROUPPER: emit vzeroupper after AVX code" }
symas.feature{ name = "prefermasks", desc = "TuningPreferMaskRegisters: prefer AVX-512 mask registers" }
symas.feature{ name = "preferlegacysetcc", desc = "TuningPreferLegacySetCC: setcc over mask registers" }
symas.feature{ name = "postra", desc = "post-RA list scheduling (PostRAScheduler)" }

-- Machine models.
symas.model{
    name = "generic", vendor = "unknown", issue_width = 4, rob = 32,
    load_latency = 4, mispredict = 10, high_latency = 10, high_uops = 4,
    flags = { "out_of_order", "default" },
    desc = "GenericX86Model: conservative 4-wide model used when no CPU is named",
}
symas.model{
    name = "skylake-client", vendor = "intel", issue_width = 6, rob = 224,
    loop_buffer = 50, load_latency = 5, mispredict = 14,
    flags = { "out_of_order", "has_stalls", "forwarding", "morphable" },
    features = { "base", "sse2", "sse3", "ssse3", "sse4.1", "sse4.2", "avx", "avx2",
                 "fma", "bmi1", "bmi2", "popcnt", "lzcnt", "aes", "pclmulqdq" },
    tune = { "macrofusion", "branchfusion", "slow3opslea", "slowdivide64",
             "popcntfalsedeps", "lzcntfalsedeps", "fastshldrotate",
             "fastscalarfsqrt", "insertvzeroupper" },
    desc = "SkylakeClientModel: 6-wide, 224-entry ROB, LSD 50, 5-cycle loads",
}
symas.model{
    name = "broadwell", vendor = "intel", issue_width = 4, rob = 192,
    loop_buffer = 50, load_latency = 5, mispredict = 16,
    flags = { "out_of_order", "has_stalls", "forwarding" },
    features = { "base", "sse2", "sse3", "ssse3", "sse4.1", "sse4.2", "avx", "avx2",
                 "fma", "bmi1", "bmi2", "popcnt", "lzcnt", "aes", "pclmulqdq" },
    tune = { "macrofusion", "branchfusion", "slow3opslea", "slowdivide64",
             "popcntfalsedeps", "fastshldrotate", "insertvzeroupper" },
    desc = "BroadwellModel: 4-wide, 192-entry ROB, 16-cycle mispredict penalty",
}
symas.model{
    name = "atom", vendor = "intel", issue_width = 2, rob = 0,
    loop_buffer = 10, load_latency = 3, high_latency = 30,
    flags = { "in_order", "post_ra", "has_stalls" },
    tune = { "postra", "slow3opslea" },
    desc = "AtomModel: 2-wide in-order, post-RA scheduler, 3-cycle loads",
}

-- Execution ports (X86SchedSkylakeClient.td: SKLPort0..7 = ProcResource<1>,
-- SKLDivider/SKLFPDivider on port 0, SKLPortAny = 60-entry unified scheduler).
symas.unit{ name = "p0", model = "skylake-client", kind = "int", count = 1, latency = 1, throughput = 1, flags = { "pipelined" } }
symas.unit{ name = "p1", model = "skylake-client", kind = "int", count = 1, latency = 1, throughput = 1, flags = { "pipelined" } }
symas.unit{ name = "p2", model = "skylake-client", kind = "load", count = 1, latency = 5, throughput = 1, flags = { "pipelined" } }
symas.unit{ name = "p3", model = "skylake-client", kind = "load", count = 1, latency = 5, throughput = 1, flags = { "pipelined" } }
symas.unit{ name = "p4", model = "skylake-client", kind = "store", count = 1, latency = 1, throughput = 1, flags = { "pipelined" } }
symas.unit{ name = "p5", model = "skylake-client", kind = "fp", count = 1, latency = 1, throughput = 1, flags = { "pipelined" } }
symas.unit{ name = "p6", model = "skylake-client", kind = "fp", count = 1, latency = 1, throughput = 1, flags = { "pipelined" } }
symas.unit{ name = "p7", model = "skylake-client", kind = "other", count = 1, latency = 1, throughput = 1, flags = { "pipelined" } }
symas.unit{ name = "divider", model = "skylake-client", kind = "divider", count = 1, latency = 25, throughput = 4, flags = { "noncoincident" } }
symas.unit{ name = "fpdivider", model = "skylake-client", kind = "divider", count = 1, latency = 11, throughput = 3, flags = { "noncoincident" } }
symas.unit{ name = "scheduler", model = "skylake-client", kind = "other", count = 1, latency = 0, throughput = 6, flags = { "superscalar" } }
-- Atom (Silvermont) execution clusters: one simple integer pipe plus a
-- second pipe for complex integer/branch work (X86ScheduleAtom.td).
symas.unit{ name = "atom-alu", model = "atom", kind = "int", count = 2, latency = 1, throughput = 1, flags = { "noncoincident" } }
symas.unit{ name = "atom-muldiv", model = "atom", kind = "divider", count = 1, latency = 30, throughput = 4 }
symas.unit{ name = "atom-ldst", model = "atom", kind = "load", count = 1, latency = 3, throughput = 1 }
symas.unit{ name = "atom-fp", model = "atom", kind = "fp", count = 1, latency = 4, throughput = 1 }
symas.unit{ name = "atom-branch", model = "atom", kind = "branch", count = 1, latency = 3, throughput = 2, flags = { "noncoincident" } }

-- Base scheduling (Skylake-client register forms).
for _, m in ipairs({ "add", "sub", "and", "or", "xor", "cmp", "test", "inc", "dec",
                     "neg", "not", "mov", "movabs" }) do
    symas.sched{ form = m, name = "WriteALU", latency = 1, uops = 1,
                 writes = { "p0", "p1", "p5", "p6" }, reads = { "p0", "p1", "p5", "p6" } }
end
symas.sched{ form = { "adc", "sbb" }, name = "WriteADC", latency = 1, uops = 1, flags = { "side_effects" },
             writes = { "p0", "p6" }, reads = { "p0", "p6" } }
symas.sched{ form = { "shl", "shr", "sar" }, name = "WriteShift", latency = 1, uops = 1,
             writes = { "p0", "p6" }, reads = { "p0", "p6" } }
symas.sched{ form = "imul", name = "WriteIMul32", latency = 3, uops = 1,
             writes = { "p1", "p0", "p6", "p5" }, reads = { "p1" } }
symas.sched{ form = "div", name = "WriteDiv64", latency = 76, uops = 32, flags = { "multicycle", "may_fault" },
             writes = { "divider" }, reads = { "divider" } }
symas.sched{ form = "idiv", name = "WriteIDiv64", latency = 102, uops = 66, flags = { "multicycle", "may_fault" },
             writes = { "divider" }, reads = { "divider" } }
symas.sched{ form = "movzx", name = "WriteMove", latency = 1, uops = 1, writes = { "p0", "p1", "p5", "p6" } }
symas.sched{ form = "movsx", name = "WriteMove", latency = 1, uops = 1, writes = { "p0", "p1", "p5", "p6" } }
symas.sched{ form = "xchg", name = "WriteXCHG", latency = 2, uops = 3, flags = { "side_effects" },
             writes = { "p0", "p1", "p5", "p6" }, reads = { "p0", "p1", "p5", "p6" } }
symas.sched{ form = "lea", name = "WriteLEA", latency = 1, uops = 1, writes = { "p1", "p5" }, reads = { "p1", "p5" } }
symas.sched{ form = "popcnt", name = "WritePOPCNT", latency = 3, uops = 1,
             writes = { "p1" }, reads = { "p1" } }
symas.sched{ form = "tzcnt", name = "WriteTZCNT", latency = 3, uops = 1,
             writes = { "p1" }, reads = { "p1" } }
symas.sched{ form = "andn", name = "WriteBLS", latency = 1, uops = 1,
             writes = { "p1", "p5" } }
symas.sched{ form = { "call", "jmp", "jcc" }, name = "WriteJump", latency = 1, uops = 1, flags = { "fused" },
             writes = { "p0", "p6" } }
symas.sched{ form = "ret", name = "WriteJump", latency = 1, uops = 1, flags = { "serializing" },
             writes = { "p0", "p6" } }
symas.sched{ form = "push", name = "WriteStore", latency = 1, uops = 1, flags = { "may_fault" },
             writes = { "p4" }, reads = { "p2", "p3", "p7" } }
symas.sched{ form = "pop", name = "WriteLoad", latency = 5, uops = 1, flags = { "may_fault" },
             writes = { "p2", "p3" } }
symas.sched{ form = { "pushf", "popf", "leave" }, name = "WriteRMW", latency = 4, uops = 2,
             flags = { "may_fault", "side_effects" }, writes = { "p2", "p3", "p4" } }
symas.sched{ form = "movaps", name = "WriteFLoad", latency = 5, uops = 1,
             flags = { "may_fault" }, writes = { "p2", "p3" } }
symas.sched{ form = "addps", name = "WriteFLogic", latency = 4, uops = 1,
             writes = { "p0", "p1" }, reads = { "p0", "p1" } }
symas.sched{ form = "vaddps", name = "WriteVAdd", latency = 4, uops = 1,
             writes = { "p0", "p1" }, reads = { "p0", "p1" } }
symas.sched{ form = "vfmadd", name = "WriteFMA", latency = 4, uops = 1,
             writes = { "p0", "p1" }, reads = { "p0", "p1" } }
symas.sched{ form = "aesenc", name = "WriteAESDecEnc", latency = 4, uops = 1,
             writes = { "p0" }, reads = { "p0" } }
symas.sched{ form = "fld", name = "WriteFLoad", latency = 6, uops = 1,
             flags = { "may_fault" }, writes = { "p2", "p3" } }
symas.sched{ form = "fadd", name = "WriteFAdd", latency = 3, uops = 1,
             writes = { "p0" }, reads = { "p0" } }
symas.sched{ form = "rdrnd", name = "WriteRDRND", latency = 100, uops = 1,
             flags = { "serializing" }, writes = { "p0", "p6" } }
symas.sched{ form = "nop", name = "WriteNop", latency = 0, uops = 1, flags = { "nop" }, writes = {} }
symas.sched{ form = "syscall", name = "WriteSystem", latency = 100, uops = 1, flags = { "serializing" },
             writes = { "p0", "p1", "p5", "p6" } }
symas.sched{ form = "cpuid", name = "WriteSystem", latency = 100, uops = 1, flags = { "serializing" },
             writes = { "p0", "p1", "p5", "p6" } }
symas.sched{ form = "cli", name = "WriteSystem", latency = 100, uops = 1, flags = { "serializing" },
             writes = { "p0", "p1", "p5", "p6" } }

-- Per-model overrides (Broadwell and Atom numbers; Skylake keeps the base).
symas.tune{ model = "broadwell", kind = "latency", form = "imul", value = 3, flags = { "override" } }
symas.tune{ model = "broadwell", kind = "uops", form = "imul", value = 1, flags = { "override" } }
symas.tune{ model = "broadwell", kind = "cost", form = "lea", value = 1,
            desc = "TuningSlow3OpsLEA: 3-operand LEA is not free on Broadwell" }
symas.tune{ model = "skylake-client", kind = "cost", form = "lea", value = 1,
            desc = "TuningSlow3OpsLEA" }
symas.tune{ model = "atom", kind = "latency", form = "imul", value = 4, flags = { "override" },
            desc = "in-order Silvermont: multiply results are forwarded late" }
symas.tune{ model = "atom", kind = "latency", form = "div", value = 30, flags = { "override" } }
symas.tune{ model = "atom", kind = "latency", form = "idiv", value = 30, flags = { "override" } }
symas.tune{ model = "atom", kind = "latency", form = "andn", value = 1, flags = { "override" } }
symas.tune{ model = "atom", kind = "prefer", form = "lea", value = 3,
            desc = "in-order core: LEA folds address arithmetic into one uop" }
symas.tune{ model = "atom", kind = "prefer", form = "andn", value = 2,
            desc = "BMI1 andn is a single uop on Silvermont" }
symas.tune{ model = "atom", kind = "avoid", form = "xchg", value = 2,
            desc = "xchg with a memory operand is a locked RMW on Atom" }
symas.tune{ model = "atom", kind = "strategy", name = "post-RA-list-sched", value = 0,
            desc = "AtomModel sets PostRAScheduler = 1" }
symas.tune{ model = "skylake-client", kind = "strategy", name = "insert-vzeroupper", value = 1,
            desc = "TuningInsertVZEROUPPER after AVX loops" }
symas.tune{ model = "skylake-client", kind = "threshold", name = "partial-register-merge", value = 2,
            desc = "merge partial-register dependencies deeper on a 224-entry ROB" }
symas.tune{ model = "broadwell", kind = "threshold", name = "partial-register-merge", value = 2 }
symas.tune{ model = "atom", kind = "threshold", name = "partial-register-merge", value = 0,
            desc = "in-order core has no room for partial-register breaking" }

-- Instruction selection: x86 folds address arithmetic into the memory
-- operand, prefers LEA for three-operand address math, CMOV for selects, and
-- eliminates xchg/chains.
symas.isel{ node = "add", form = "add", kind = "node", cost = 1, complexity = 1,
            flags = { "commutes" }, pattern = "(add GPR:$a, GPR:$b)" }
symas.isel{ node = "add", form = "lea", kind = "node", cost = 1, complexity = 3,
            pattern = "lea (%r1,%r2,4), %dst when the add feeds an addressing mode" }
symas.isel{ node = "sub", form = "sub", kind = "node", cost = 1, complexity = 1, pattern = "(sub GPR:$a, GPR:$b)" }
symas.isel{ node = "and", form = "and", kind = "node", cost = 1, complexity = 1,
            flags = { "commutes" }, pattern = "(and GPR:$a, GPR:$b)" }
symas.isel{ node = "or", form = "or", kind = "node", cost = 1, complexity = 1,
            flags = { "commutes" }, pattern = "(or GPR:$a, GPR:$b)" }
symas.isel{ node = "xor", form = "xor", kind = "node", cost = 1, complexity = 1,
            flags = { "commutes" }, pattern = "(xor GPR:$a, GPR:$b)" }
symas.isel{ node = "xor", form = "xor", kind = "node", cost = 0, complexity = 2,
            pattern = "xor %eax, %eax is a zeroing idiom (bypass elimination)" }
symas.isel{ node = "shl", form = "shl", kind = "node", cost = 1, complexity = 1, pattern = "(shl GPR:$a, GPR:$b)" }
symas.isel{ node = "mul", form = "imul", kind = "node", cost = 3, complexity = 2, pattern = "(mul GPR:$a, GPR:$b)" }
symas.isel{ node = "sdiv", form = "idiv", kind = "node", cost = 102, complexity = 4,
            flags = { "unprofitable" }, pattern = "(sdiv GPR:$a, GPR:$b)" }
symas.isel{ node = "udiv", form = "div", kind = "node", cost = 76, complexity = 4,
            flags = { "unprofitable" }, pattern = "(udiv GPR:$a, GPR:$b)" }
symas.isel{ node = "load", form = "mov", kind = "node", cost = 5, complexity = 2,
            pattern = "(load (seqcst, GPR:$addr), GPR:$dst)" }
symas.isel{ node = "store", form = "mov", kind = "node", cost = 1, complexity = 2,
            pattern = "(store GPR:$val, (seqcst, GPR:$addr))" }
symas.isel{ node = "store", form = "andn", kind = "node", cost = 1, complexity = 4,
            required = { "bmi1" }, pattern = "andn+store: masked store using the BMI1 andn" }
symas.isel{ node = "br", form = "call", kind = "node", cost = 1, complexity = 1, pattern = "(call GPR:$addr)" }
symas.isel{ node = "br", form = "jmp", kind = "node", cost = 1, complexity = 1, pattern = "(brind GPR:$addr)" }
symas.isel{ node = "br", form = "jcc", kind = "node", cost = 1, complexity = 2,
            pattern = "(brcond (setcc GPR:$cc))" }
symas.isel{ node = "select", form = "jcc", kind = "select", cost = 1, complexity = 3,
            pattern = "select lowered as a branch when the values are cheap to rematerialize" }
symas.isel{ node = "select", form = "xchg", kind = "select", cost = 2, complexity = 5,
            pattern = "select via xchg when the destination is a memory location" }
symas.isel{ node = "zext", form = "movzx", kind = "node", cost = 1, complexity = 2,
            pattern = "(zext GPR:$src)" }
symas.isel{ node = "sext", form = "movsx", kind = "node", cost = 1, complexity = 2,
            pattern = "(sext GPR:$src)" }
symas.isel{ node = "COPY", form = "mov", kind = "copy", cost = 0, complexity = 1,
            flags = { "prefer" }, pattern = "register copy coalesced into mov or eliminated" }
symas.isel{ node = "ctpop", form = "popcnt", kind = "node", cost = 3, complexity = 2,
            required = { "popcnt" }, pattern = "(ctpop GPR:$src)" }
symas.isel{ node = "cttz", form = "tzcnt", kind = "node", cost = 3, complexity = 2,
            required = { "lzcnt" }, pattern = "(cttz GPR:$src)" }
symas.isel{ node = "fadd", form = "vfmadd", kind = "node", cost = 4, complexity = 3,
            required = { "fma" }, pattern = "(fadd (fmul $a, $b), $c) contracts into vfmadd" }
symas.isel{ node = "fadd", form = "addps", kind = "node", cost = 4, complexity = 2,
            required = { "sse" }, pattern = "(fadd VR:$a, VR:$b)" }
symas.isel{ node = "fadd", form = "vaddps", kind = "node", cost = 4, complexity = 2,
            required = { "avx" }, pattern = "(fadd VR:$a, VR:$b) on a VEX-encoded register" }
symas.isel{ node = "AESEncryption.enc", form = "aesenc", kind = "node", cost = 4, complexity = 3,
            required = { "aes" } }
symas.isel{ node = "FRAMEHOLDER", form = "push", kind = "node", cost = 1, complexity = 1,
            flags = { "side_effects" } }
symas.isel{ node = "RETURNADDR", form = "call", kind = "node", cost = 1, complexity = 1 }

-- Macro fusion: x86 fuses cmp/test with jcc, and jcc/jmp with a following
-- instruction on cores that support it (X86.td TuningMacroFusion /
-- TuningBranchFusion).
symas.fuse{ name = "cmp-jcc", a = "cmp", b = "jcc", kind = "cmp_branch", latency = 1,
            features = { "macrofusion" },
            flags = { "profitable", "requires_flags", "adjacent", "bidirectional" },
            pattern = "cmp/test %reg, %reg ; jcc" }
symas.fuse{ name = "test-jcc", a = "test", b = "jcc", kind = "cmp_branch", latency = 1,
            features = { "macrofusion" },
            flags = { "profitable", "requires_flags", "adjacent", "bidirectional" },
            pattern = "test %reg, %reg ; jcc" }
symas.fuse{ name = "add-jcc", a = "add", b = "jcc", kind = "cmp_branch", latency = 1,
            features = { "macrofusion" },
            flags = { "profitable", "requires_flags", "adjacent" },
            pattern = "add/sub/cmp/test with a memory operand ; jcc" }
symas.fuse{ name = "and-jcc", a = "and", b = "jcc", kind = "cmp_branch", latency = 1,
            features = { "macrofusion" },
            flags = { "profitable", "requires_flags", "adjacent" } }
symas.fuse{ name = "cmp-jmp", a = "cmp", b = "jmp", kind = "branch_pair", latency = 1,
            features = { "macrofusion" }, flags = { "profitable", "requires_flags", "adjacent" } }
symas.fuse{ name = "cmp-jcc-cmov", a = "cmp", b = "jcc", kind = "cmp_select", latency = 1,
            features = { "macrofusion" }, flags = { "profitable", "requires_flags" },
            pattern = "compare feeding a conditional move is a single fused-domain op" }
symas.fuse{ name = "jmp-alu", a = "jmp", b = "add", kind = "branch_pair",
            features = { "branchfusion" }, flags = { "profitable", "adjacent" },
            pattern = "TuningBranchFusion: a jump may fuse with the following instruction" }
symas.fuse{ name = "alu-alu", a = "add", b = "cmp", kind = "macro", latency = 1,
            flags = { "profitable", "adjacent" },
            pattern = "micro-op fusion of two independent ALU micro-ops" }
symas.fuse{ name = "load-alu", a = "mov", b = "add", kind = "mem_arith", latency = 5,
            flags = { "profitable", "adjacent" },
            pattern = "micro-fusion of a load with an ALU operation" }

symas.debug{ msg = "SkylakeClientModel: 6-wide, ROB 224, LoadLatency 5", kind = "model", ref = "skylake-client" }
symas.debug{ msg = "GenericX86Model: 4-wide, ROB 32, no per-op table", kind = "model", ref = "generic" }
symas.debug{ msg = "base schedule table = Skylake register forms", kind = "sched", ref = "add" }
symas.debug{ msg = "cmp/test + jcc macro-fusion (TuningMacroFusion)", kind = "fusion", ref = "cmp-jcc" }
symas.debug{ msg = "x86 is micro-fused: many source instructions map to one micro-op", kind = "unit", ref = "scheduler" }

print(symas.emit())
