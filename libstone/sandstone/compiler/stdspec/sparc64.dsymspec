-- sparc64.dsymspec — SPARC V9 (sparc64), big-endian, register windows, ELFv9.
-- Data: TableGen Sparc target (GPR windows G/O/L/I, FPR/DPR/QPR, FCC/ASI/
-- CCR/CWP status, PC/NPC/Y), arch_oracle sparc64 summary, toolchain_orace
-- (R_SPARC_* relocations: WDISP30/22, HI22/LO10, GOT/TLS), ccbe_oracle ABI
-- (register windows, save/restore, delay slots).
-- Strata: base(v9) | fpu | vis/vis2/vis3 | popc | crypto | cbcond | priv.
local symas = require("dsl").new()

symas.target{
    arch = "sparc64", subarch = "v9",
    addr_size = 64, op_size = 32, addr_def = 64, align = 4,
    byte_order = "big", obj_format = "ELF64", abi = "SPARC-V9",
    calling_conv = "sparc-v9",
    features = { "base", "v9", "fpu" },
}

symas.feature{ name = "base", desc = "SPARC V9 base integer + windows" }
symas.feature{ name = "v9", desc = "SPARC V9 (64-bit)" }
symas.feature{ name = "fpu", desc = "floating point unit" }
symas.feature{ name = "vis", desc = "Visual Instruction Set" }
symas.feature{ name = "vis2", desc = "VIS2" }
symas.feature{ name = "vis3", desc = "VIS3" }
symas.feature{ name = "vis4", desc = "VIS4" }
symas.feature{ name = "popc", desc = "population count" }
symas.feature{ name = "fmaf", desc = "fused multiply-add" }
symas.feature{ name = "cbcond", desc = "compare-and-branch" }
symas.feature{ name = "pause", desc = "pause/spause" }
symas.feature{ name = "crypto", desc = "crypto (camellia/aes/des/kasumi)" }
symas.feature{ name = "priv", desc = "privileged (ASI/tick/wrpr)" }

for i = 0, 31 do
    symas.register{ name = "%r" .. i, class = "gpr", width = 64, enc = i, flags = { "readable", "writable" } }
end
local wins = { { "g", 0 }, { "o", 8 }, { "l", 16 }, { "i", 24 } }
for _, w in ipairs(wins) do
    for j = 0, 7 do
        symas.register{ name = "%" .. w[1] .. j, class = "gpr", width = 64, enc = w[2] + j,
                        flags = { "readable", "writable" } }
    end
end
for i = 0, 31 do
    symas.register{ name = "%f" .. i, class = "fp", width = 32, enc = i, flags = { "readable", "writable" } }
end
for i = 0, 30, 2 do
    symas.register{ name = "%d" .. i, class = "fp", width = 64, enc = i, parent = "%f" .. i,
                    sub_lo = 0, sub_hi = 32, flags = { "readable", "writable" } }
end
for i = 0, 28, 4 do
    symas.register{ name = "%q" .. i, class = "vec", width = 128, enc = i, parent = "%f" .. i,
                    sub_lo = 0, sub_hi = 32, flags = { "readable", "writable" } }
end
symas.register{ name = "%sp", class = "gpr", width = 64, enc = 14, flags = { "readable", "writable" } }
symas.register{ name = "%fp", class = "gpr", width = 64, enc = 30, flags = { "readable", "writable" } }
symas.register{ name = "%pc", class = "special", width = 64, enc = 0 }
symas.register{ name = "%npc", class = "special", width = 64, enc = 0 }
symas.register{ name = "%psr", class = "status", width = 64, enc = 0 }
symas.register{ name = "%ccr", class = "status", width = 8, enc = 0 }
symas.register{ name = "%fcc0", class = "status", width = 8, enc = 0 }
symas.register{ name = "%y", class = "special", width = 64, enc = 0 }
symas.register{ name = "%asi", class = "ctrl", width = 8, enc = 0, flags = { "modedep" } }
symas.register{ name = "%tick", class = "ctrl", width = 64, enc = 0, flags = { "modedep" } }
symas.register{ name = "%cwp", class = "ctrl", width = 8, enc = 0, flags = { "modedep" } }

-- SPARC V9 skeletons (op/op3/rd/rs1/rs2-or-simm13).
symas.encoder{ name = "nop",  source = "emit32be(0x01000000);", max_bytes = 4 }
symas.encoder{ name = "add",  source = "emit32be(0x80000000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "addcc", source = "emit32be(0x80800000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "and",  source = "emit32be(0x80080000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "or",   source = "emit32be(0x80100000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "xor",  source = "emit32be(0x80180000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "sub",  source = "emit32be(0x80200000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "mulx", source = "emit32be(0x80380000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "sdivx", source = "emit32le(0x803C0000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "sllx", source = "emit32be(0x81281000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "srlx", source = "emit32be(0x81301000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "srax", source = "emit32be(0x81381000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "cmp",  source = "emit32be(0x80A00000 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "sethi", source = "emit32be(0x01000000 + rd*33554432 + (imm % 4194304));", max_bytes = 4 }
symas.encoder{ name = "ld",   source = "emit32be(0xC0000000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "ldx",  source = "emit32be(0xC0580000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "ldub", source = "emit32be(0xC0080000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "st",   source = "emit32be(0xC0200000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "stx",  source = "emit32be(0xC0780000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "stb",  source = "emit32be(0xC0280000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "lda",  source = "emit32be(0xC0008000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "sta",  source = "emit32be(0xC0208000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "jmpl", source = "emit32be(0x81C00000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "call", source = "emit32be(0x40000000); emit_relocation(sym, R_SPARC_WDISP30);", max_bytes = 4, max_relocs = 1 }
symas.encoder{ name = "br",   source = "emit32be(0x10800000); emit_relocation(sym, R_SPARC_WDISP22);", max_bytes = 4, max_relocs = 1 }
symas.encoder{ name = "cbcond", source = "emit32be(0x10A00000 + rs1*16384); emit_relocation(sym, R_SPARC_WDISP16);", max_bytes = 4, max_relocs = 1 }
symas.encoder{ name = "save", source = "emit32be(0x81E00000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "restore", source = "emit32be(0x81E80000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "ret",  source = "emit32be(0x81C3E008);", max_bytes = 4 }
symas.encoder{ name = "retl", source = "emit32be(0x81C7E008);", max_bytes = 4 }
symas.encoder{ name = "ta",   source = "emit32be(0x91D00000 + (imm % 128));", max_bytes = 4 }
symas.encoder{ name = "flush", source = "emit32be(0x81D80000 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "membar", source = "emit32be(0x81430000 + (imm % 128));", max_bytes = 4 }
symas.encoder{ name = "prefetch", source = "emit32be(0xC1600000 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "fadds", source = "emit32be(0x81000040 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "fmuld", source = "emit32be(0x81000242 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "fcmpd", source = "emit32be(0x81000254 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "fpadd16", source = "emit32be(0x81100050 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "pdist", source = "emit32be(0x8110025E + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "popc", source = "emit32be(0x81480000 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "aes",  source = "emit32be(0x81100280 + rd*33554432 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "wrpr", source = "emit32be(0x81880000 + rs1*16384 + rs2);", max_bytes = 4 }
symas.encoder{ name = "done", source = "emit32be(0x81F00000);", max_bytes = 4 }
symas.encoder{ name = "retry", source = "emit32be(0x83F00000);", max_bytes = 4 }

local function r() return { kind = "reg", class = "gpr", width = 64 } end
local function wr() return { kind = "reg", class = "gpr", width = 64, access = "write" } end

for _, m in ipairs({ "nop", "add", "addcc", "and", "or", "xor", "sub",
    "mulx", "sdivx", "sllx", "srlx", "srax", "cmp", "sethi", "ld", "ldx",
    "ldub", "st", "stx", "stb", "lda", "sta", "jmpl", "call", "br",
    "cbcond", "save", "restore", "ret", "retl", "ta", "flush", "membar",
    "prefetch", "fadds", "fmuld", "fcmpd", "fpadd16", "pdist", "popc",
    "aes", "wrpr", "done", "retry" }) do
    symas.mnemonic{ name = m }
end
symas.form{ mnemonic = "nop", encoder = "nop" }
symas.form{ mnemonic = "add", encoder = "add", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "addcc", encoder = "addcc", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "and", encoder = "and", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "or",  encoder = "or",  operands = { wr(), r(), r() } }
symas.form{ mnemonic = "xor", encoder = "xor", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "sub", encoder = "sub", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "mulx", encoder = "mulx", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "sdivx", encoder = "sdivx", flags = { "may_trap" }, operands = { wr(), r(), r() } }
symas.form{ mnemonic = "sllx", encoder = "sllx", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "srlx", encoder = "srlx", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "srax", encoder = "srax", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "cmp", encoder = "cmp", operands = { r(), r() } }
symas.form{ mnemonic = "sethi", encoder = "sethi", flags = { "reloc" }, operands = { wr(),
    { kind = "imm", width = 22, signed = false, imm_min = 0, imm_max = 4194303 } } }
symas.form{ mnemonic = "ld", encoder = "ld", flags = { "reads_mem" }, operands = { wr(), { kind = "mem", width = 32 }, r() } }
symas.form{ mnemonic = "ldx", encoder = "ldx", flags = { "reads_mem" }, operands = { wr(), { kind = "mem", width = 64 }, r() } }
symas.form{ mnemonic = "ldub", encoder = "ldub", flags = { "reads_mem" }, operands = { wr(), { kind = "mem", width = 8 }, r() } }
symas.form{ mnemonic = "st", encoder = "st", flags = { "writes_mem" }, operands = { r(), { kind = "mem", width = 32 }, r() } }
symas.form{ mnemonic = "stx", encoder = "stx", flags = { "writes_mem" }, operands = { r(), { kind = "mem", width = 64 }, r() } }
symas.form{ mnemonic = "stb", encoder = "stb", flags = { "writes_mem" }, operands = { r(), { kind = "mem", width = 8 }, r() } }
symas.form{ mnemonic = "lda", encoder = "lda", required = { "priv" }, flags = { "privileged", "reads_mem" },
    operands = { wr(), { kind = "mem", width = 32 }, r() } }
symas.form{ mnemonic = "sta", encoder = "sta", required = { "priv" }, flags = { "privileged", "writes_mem" },
    operands = { r(), { kind = "mem", width = 32 }, r() } }
symas.form{ mnemonic = "jmpl", encoder = "jmpl", flags = { "branch", "delayed" }, operands = { r(), r(), wr() } }
symas.form{ mnemonic = "call", encoder = "call", flags = { "branch", "delayed", "reloc" }, operands = { { kind = "sym", width = 64 } } }
symas.form{ mnemonic = "br", encoder = "br", flags = { "cond_branch", "delayed", "reloc" },
    operands = { { kind = "cond", width = 8 }, { kind = "sym", width = 64 } } }
symas.form{ mnemonic = "cbcond", encoder = "cbcond", required = { "cbcond" }, flags = { "cond_branch", "reloc" },
    operands = { r(), { kind = "sym", width = 64 } } }
symas.form{ mnemonic = "save", encoder = "save", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "restore", encoder = "restore", operands = { wr(), r(), r() } }
symas.form{ mnemonic = "ret", encoder = "ret", flags = { "return", "terminator", "delayed" } }
symas.form{ mnemonic = "retl", encoder = "retl", flags = { "return", "terminator", "delayed" } }
symas.form{ mnemonic = "ta", encoder = "ta", flags = { "may_trap" }, operands = {
    { kind = "imm", width = 8, signed = false, imm_min = 0, imm_max = 127 } } }
symas.form{ mnemonic = "flush", encoder = "flush", operands = { r(), r() } }
symas.form{ mnemonic = "membar", encoder = "membar", operands = {
    { kind = "imm", width = 8, signed = false, imm_min = 0, imm_max = 127 } } }
symas.form{ mnemonic = "prefetch", encoder = "prefetch", flags = { "reads_mem" }, operands = { { kind = "mem", width = 64 }, r() } }
symas.form{ mnemonic = "fadds", encoder = "fadds", required = { "fpu" },
    operands = { { kind = "reg", class = "fp", width = 32, access = "write" },
                 { kind = "reg", class = "fp", width = 32 }, { kind = "reg", class = "fp", width = 32 } } }
symas.form{ mnemonic = "fmuld", encoder = "fmuld", required = { "fpu" },
    operands = { { kind = "reg", class = "fp", width = 64, access = "write" },
                 { kind = "reg", class = "fp", width = 64 }, { kind = "reg", class = "fp", width = 64 } } }
symas.form{ mnemonic = "fcmpd", encoder = "fcmpd", required = { "fpu" },
    operands = { { kind = "reg", class = "fp", width = 64 }, { kind = "reg", class = "fp", width = 64 } } }
symas.form{ mnemonic = "fpadd16", encoder = "fpadd16", required = { "vis" },
    operands = { { kind = "reg", class = "vec", width = 128, access = "write" },
                 { kind = "reg", class = "vec", width = 128 }, { kind = "reg", class = "vec", width = 128 } } }
symas.form{ mnemonic = "pdist", encoder = "pdist", required = { "vis" }, operands = { wr(), r(), r() } }
symas.form{ mnemonic = "popc", encoder = "popc", required = { "popc" }, operands = { wr(), r() } }
symas.form{ mnemonic = "aes", encoder = "aes", required = { "crypto" }, operands = { wr(), r(), r() } }
symas.form{ mnemonic = "wrpr", encoder = "wrpr", required = { "priv" }, flags = { "privileged" }, operands = { r(), r() } }
symas.form{ mnemonic = "done", encoder = "done", required = { "priv" }, flags = { "privileged", "return", "terminator" } }
symas.form{ mnemonic = "retry", encoder = "retry", required = { "priv" }, flags = { "privileged", "return", "terminator" } }

symas.syntax{ name = "default", comment = "!", separator = ", " }

symas.section{ name = ".text", flags = { "exec", "alloc", "code" }, align = 4, content = "code" }
symas.section{ name = ".rodata", flags = { "alloc", "readonly", "data" }, align = 8, content = "data" }
symas.section{ name = ".data", flags = { "write", "alloc", "data" }, align = 8, content = "data" }
symas.section{ name = ".bss", flags = { "write", "alloc", "zerofill", "data" }, align = 8, content = "data" }
symas.section{ name = ".tdata", flags = { "write", "alloc", "tls", "data" }, align = 8, content = "data" }
symas.section{ name = ".got", flags = { "write", "alloc", "data" }, align = 8, content = "data" }
symas.section{ name = ".plt", flags = { "exec", "alloc", "code" }, align = 8, content = "code" }

symas.linkage{ name = "func_global", binding = "global", visibility = "default", symtype = "func" }
symas.linkage{ name = "func_weak", binding = "weak", visibility = "default", symtype = "func" }
symas.linkage{ name = "object_global", binding = "global", visibility = "default", symtype = "object" }
symas.linkage{ name = "tls_var", binding = "tls", visibility = "default", symtype = "object" }
symas.linkage{ name = "local_sym", binding = "local", visibility = "default", symtype = "none" }

symas.reloc{ name = "R_SPARC_NONE", width = 32, expr = "S + A" }
symas.reloc{ name = "R_SPARC_64", width = 64, expr = "S + A" }
symas.reloc{ name = "R_SPARC_32", width = 32, expr = "S + A" }
symas.reloc{ name = "R_SPARC_16", width = 32, expr = "S + A" }
symas.reloc{ name = "R_SPARC_WDISP30", width = 32, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_SPARC_WDISP22", width = 32, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_SPARC_WDISP19", width = 32, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_SPARC_WDISP16", width = 32, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_SPARC_HI22", width = 32, expr = "HI22(S + A)" }
symas.reloc{ name = "R_SPARC_LO10", width = 32, expr = "LO10(S + A)" }
symas.reloc{ name = "R_SPARC_HIX22", width = 32, expr = "HIX22(S + A)" }
symas.reloc{ name = "R_SPARC_LOX10", width = 32, expr = "LO10(S + A)" }
symas.reloc{ name = "R_SPARC_GOT22", width = 32, expr = "GOT(S) + A" }
symas.reloc{ name = "R_SPARC_GOT10", width = 32, expr = "GOT(S) + A" }
symas.reloc{ name = "R_SPARC_PC22", width = 32, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_SPARC_PC10", width = 32, signed = true, pcrel = true, expr = "S + A - P" }
symas.reloc{ name = "R_SPARC_TLS_GD_HI22", width = 32, expr = "TLS(S) + A" }
symas.reloc{ name = "R_SPARC_TLS_GD_LO10", width = 32, expr = "TLS(S) + A" }
symas.reloc{ name = "R_SPARC_TLS_TPOFF32", width = 32, expr = "TLS(S) + A" }
symas.reloc{ name = "R_SPARC_RELATIVE", width = 64, expr = "B + A" }
symas.reloc{ name = "R_SPARC_GLOB_DAT", width = 64, expr = "S + A" }
symas.reloc{ name = "R_SPARC_JMP_SLOT", width = 64, expr = "S + A" }

symas.debug{ msg = "sparcv9 windows+delay slots+fpu/vis/crypto+priv", kind = "target", ref = "" }
symas.debug{ msg = "vis forms require vis", kind = "form", ref = "fpadd16" }
symas.debug{ msg = "privileged ASI forms need priv", kind = "form", ref = "lda" }

-- ---------------------------------------------------------------------------
-- Instruction selection, scheduling, and per-model optimization
-- ---------------------------------------------------------------------------
-- Sources: arch_oracle / isa_reference SPARC V9 facts (in-order issue,
-- register windows G/O/L/I, dual-issue pairs, 2-cycle ALU, %hi/%lo add
-- sequences, 16-cycle fmul, VIS vector ops), ccbe_oracle (SPARC ABI stack
-- frames: save/restore, leaf-function retl), toolchain_oracle (R_SPARC_*
-- relocations). LLVM's Sparc target carries no SchedMachineModel, so the
-- model below is derived from the SPARC V9 User's Guide pipeline tables.

symas.model{
    name = "ultra1", vendor = "sun", issue_width = 1, rob = 0,
    load_latency = 6, mispredict = 16, high_latency = 16,
    flags = { "in_order", "has_stalls", "forwarding", "complete", "default" },
    features = { "base", "v9", "fpu" },
    desc = "SPARC V9 reference pipeline: 1 IPC, 2-cycle integer ALU, 6-cycle load",
}
symas.model{
    name = "niagara", vendor = "sun", issue_width = 4, rob = 0,
    load_latency = 4, mispredict = 14,
    flags = { "out_of_order", "has_stalls", "forwarding" },
    features = { "base", "v9", "fpu", "vis" },
    desc = "Niagara-class: 4 issue threads, short load latency",
}
symas.unit{ name = "sp-alu",  model = "ultra1", kind = "int", count = 1, latency = 2, throughput = 1, flags = { "noncoincident" } }
symas.unit{ name = "sp-shift",model = "ultra1", kind = "int", count = 1, latency = 2, throughput = 1, flags = { "noncoincident" } }
symas.unit{ name = "sp-ld",   model = "ultra1", kind = "load", count = 1, latency = 6, throughput = 1 }
symas.unit{ name = "sp-st",   model = "ultra1", kind = "store", count = 1, latency = 1, throughput = 1 }
symas.unit{ name = "sp-fpu",  model = "ultra1", kind = "fp", count = 1, latency = 16, throughput = 1, flags = { "noncoincident" } }
symas.unit{ name = "sp-b",    model = "ultra1", kind = "branch", count = 1, latency = 1, throughput = 1 }
symas.unit{ name = "sp-vis",  model = "niagara", kind = "vector", count = 1, latency = 3, throughput = 1, flags = { "pipelined" } }
symas.unit{ name = "sp-alu4", model = "niagara", kind = "int", count = 2, latency = 1, throughput = 1, flags = { "pipelined" } }

for _, m in ipairs({ "add", "addcc", "and", "or", "xor", "sub" }) do
    symas.sched{ form = m, name = "WriteALU", latency = 2, uops = 1, writes = { "sp-alu" }, reads = { "sp-alu" } }
end
symas.sched{ form = "sethi", name = "WriteALU", latency = 1, uops = 1, writes = { "sp-alu" } }
symas.sched{ form = { "sllx", "srlx", "srax" }, name = "WriteShift", latency = 2, uops = 1, writes = { "sp-shift" }, reads = { "sp-shift" } }
symas.sched{ form = "cmp", name = "WriteCmp", latency = 1, uops = 1, flags = { "side_effects" }, writes = { "sp-alu" }, reads = { "sp-alu" } }
symas.sched{ form = { "mulx", "sdivx" }, name = "WriteMulDiv", latency = 24, uops = 1, flags = { "multicycle" }, writes = { "sp-alu" }, reads = { "sp-alu" } }
symas.sched{ form = { "ld", "ldx", "ldub" }, name = "WriteLoad", latency = 6, uops = 1, flags = { "may_fault" }, writes = { "sp-ld" } }
symas.sched{ form = { "lda" }, name = "WriteLoadA", latency = 6, uops = 1, flags = { "may_fault" }, writes = { "sp-ld" } }
symas.sched{ form = { "st", "stx", "stb" }, name = "WriteStore", latency = 1, uops = 1, flags = { "may_fault" }, writes = { "sp-st" } }
symas.sched{ form = "sta", name = "WriteStoreA", latency = 1, uops = 1, flags = { "may_fault" }, writes = { "sp-st" } }
symas.sched{ form = { "jmpl", "call" }, name = "WriteJump", latency = 1, uops = 1, flags = { "fused" }, writes = { "sp-b" } }
symas.sched{ form = "br", name = "WriteJump", latency = 1, uops = 1, flags = { "serializing" }, writes = { "sp-b" } }
symas.sched{ form = "cbcond", name = "WriteCBcond", latency = 1, uops = 1, flags = { "fused" }, writes = { "sp-b" } }
symas.sched{ form = "retl", name = "WriteRetl", latency = 1, uops = 1, flags = { "serializing" }, writes = { "sp-b" } }
symas.sched{ form = "ret", name = "WriteRet", latency = 1, uops = 1, flags = { "serializing" }, writes = { "sp-b" } }
symas.sched{ form = { "save", "restore" }, name = "WriteSaveRestore", latency = 4, uops = 2, flags = { "side_effects" }, writes = { "sp-st", "sp-ld" } }
symas.sched{ form = "fadds", name = "WriteFAdd", latency = 4, uops = 1, flags = { "side_effects" }, writes = { "sp-fpu" }, reads = { "sp-fpu" } }
symas.sched{ form = "fmuld", name = "WriteFMul", latency = 16, uops = 1, flags = { "side_effects" }, writes = { "sp-fpu" }, reads = { "sp-fpu" } }
symas.sched{ form = "fcmpd", name = "WriteFCmp", latency = 4, uops = 1, flags = { "side_effects" }, writes = { "sp-fpu" }, reads = { "sp-fpu" } }
symas.sched{ form = { "fpadd16", "pdist" }, name = "WriteVIS", latency = 3, uops = 1, writes = { "sp-vis" }, reads = { "sp-vis" } }
symas.sched{ form = "popc", name = "WriteVIS", latency = 3, uops = 1, writes = { "sp-vis" }, reads = { "sp-vis" } }
symas.sched{ form = "aes", name = "WriteAES", latency = 3, uops = 1, writes = { "sp-vis" }, reads = { "sp-vis" } }
symas.sched{ form = { "membar", "flush" }, name = "WriteFence", latency = 1, uops = 1, flags = { "serializing", "barrier" }, writes = { "sp-st" } }
symas.sched{ form = "prefetch", name = "WritePrefetch", latency = 1, uops = 1, flags = { "side_effects" }, writes = {} }
symas.sched{ form = "ta", name = "WriteTrap", latency = 1, uops = 1, flags = { "serializing" }, writes = { "sp-b" } }
symas.sched{ form = { "done", "retry" }, name = "WriteTrap", latency = 1, uops = 1, flags = { "serializing" }, writes = { "sp-b" } }
symas.sched{ form = "wrpr", name = "WritePrivileged", latency = 1, uops = 1, flags = { "serializing" }, writes = { "sp-b" } }
symas.sched{ form = "nop", name = "WriteNop", latency = 0, uops = 1, flags = { "nop" }, writes = {} }

symas.tune{ model = "ultra1", kind = "avoid", form = "fmuld", value = 8,
            desc = "no FMA on the reference pipeline: multiply is 16 cycles" }
symas.tune{ model = "ultra1", kind = "avoid", form = "mulx", value = 6,
            desc = "integer multiply is 24 cycles on the 1-IPC pipeline" }
symas.tune{ model = "ultra1", kind = "avoid", form = "sdivx", value = 6 }
symas.tune{ model = "ultra1", kind = "prefer", form = "retl", value = 3,
            desc = "leaf functions use retl (no save/restore)" }
symas.tune{ model = "ultra1", kind = "prefer", form = "sethi", value = 2,
            desc = "sethi is 1 cycle: materialising a 32-bit constant is cheap" }
symas.tune{ model = "niagara", kind = "latency", form = "ld", value = 4, flags = { "override" } }
symas.tune{ model = "niagara", kind = "latency", form = "fmuld", value = 5, flags = { "override" },
            desc = "fused multiply-add pipeline" }
symas.tune{ model = "niagara", kind = "prefer", form = "fmuld", value = 2 }
symas.tune{ model = "niagara", kind = "prefer", form = "fpadd16", value = 2,
            desc = "VIS is 4-wide and much cheaper than scalar FP" }
symas.tune{ model = "niagara", kind = "threshold", name = "window-issue", value = 4,
            desc = "Niagara issues four independent thread operations per cycle" }
symas.tune{ model = "ultra1", kind = "threshold", name = "window-issue", value = 1 }

symas.isel{ node = "add", form = "add", kind = "node", cost = 2, complexity = 1,
            flags = { "commutes" }, pattern = "(add GPR:$a, GPR:$b)" }
symas.isel{ node = "add", form = "sethi", kind = "node", cost = 1, complexity = 2,
            pattern = "(add (i32 0), (i32 imm22))" }
symas.isel{ node = "add", form = "addcc", kind = "node", cost = 2, complexity = 2,
            flags = { "side_effects" }, pattern = "addcc when the ICC flags are live" }
symas.isel{ node = "sub", form = "sub", kind = "node", cost = 2, complexity = 1, pattern = "(sub GPR:$a, GPR:$b)" }
symas.isel{ node = "and", form = "and", kind = "node", cost = 2, complexity = 1,
            flags = { "commutes" }, pattern = "(and GPR:$a, GPR:$b)" }
symas.isel{ node = "or", form = "or", kind = "node", cost = 2, complexity = 1,
            flags = { "commutes" }, pattern = "(or GPR:$a, GPR:$b)" }
symas.isel{ node = "xor", form = "xor", kind = "node", cost = 2, complexity = 1,
            flags = { "commutes" }, pattern = "(xor GPR:$a, GPR:$b)" }
symas.isel{ node = "shl", form = "sllx", kind = "node", cost = 2, complexity = 1, pattern = "(shl GPR:$a, GPR:$b)" }
symas.isel{ node = "mul", form = "mulx", kind = "node", cost = 24, complexity = 2,
            flags = { "unprofitable" }, pattern = "(mul GPR:$a, GPR:$b)" }
symas.isel{ node = "sdiv", form = "sdivx", kind = "node", cost = 24, complexity = 3,
            flags = { "unprofitable" }, pattern = "(sdiv GPR:$a, GPR:$b)" }
symas.isel{ node = "load", form = "ld", kind = "node", cost = 6, complexity = 2, pattern = "(load GPR:$addr)" }
symas.isel{ node = "load", form = "ldx", kind = "node", cost = 6, complexity = 2, pattern = "(load GPR:$addr) 64-bit" }
symas.isel{ node = "store", form = "st", kind = "node", cost = 1, complexity = 2, pattern = "(store GPR:$val, GPR:$addr)" }
symas.isel{ node = "store", form = "stx", kind = "node", cost = 1, complexity = 2, pattern = "(store GPR:$val, GPR:$addr) 64-bit" }
symas.isel{ node = "br", form = "jmpl", kind = "node", cost = 1, complexity = 1, pattern = "(br GPR:$addr)" }
symas.isel{ node = "br", form = "call", kind = "node", cost = 1, complexity = 1, pattern = "(call GPR:$addr)" }
symas.isel{ node = "br", form = "br", kind = "node", cost = 1, complexity = 1, pattern = "(brcond eq, 0, GPR:$addr)" }
symas.isel{ node = "br", form = "cbcond", kind = "node", cost = 1, complexity = 3,
            pattern = "cbcond: compare and branch without an explicit ICC write" }
symas.isel{ node = "br", form = "retl", kind = "node", cost = 1, complexity = 2, pattern = "leaf-function return" }
symas.isel{ node = "br", form = "ret", kind = "node", cost = 1, complexity = 1, pattern = "callee return (restores the window)" }
symas.isel{ node = "COPY", form = "or", kind = "copy", cost = 2, complexity = 2, flags = { "prefer" },
            pattern = "COPY = or %g0, %src, 0" }
symas.isel{ node = "frame_addr", form = "save", kind = "node", cost = 4, complexity = 2,
            pattern = "save establishes a register window and frame" }
symas.isel{ node = "MEMBARRIER", form = "membar", kind = "node", cost = 1, complexity = 1,
            flags = { "side_effects", "prefer" } }
symas.isel{ node = "MEMBARRIER", form = "flush", kind = "node", cost = 1, complexity = 1,
            pattern = "flushing I-cache" }
symas.isel{ node = "fadd", form = "fadds", kind = "node", cost = 4, complexity = 2, required = { "fpu" } }
symas.isel{ node = "fmul", form = "fmuld", kind = "node", cost = 16, complexity = 2, required = { "fpu" } }
symas.isel{ node = "fadd", form = "fpadd16", kind = "node", cost = 3, complexity = 3, required = { "vis" },
            pattern = "VIS paired-scalar add" }
symas.tune{ model = "niagara", kind = "prefer", form = "fmuld", value = 3,
            desc = "the fmaf feature contracts multiply-add into one pipeline pass" }
symas.isel{ node = "fadd", form = "fpadd16", kind = "node", cost = 3, complexity = 3, required = { "vis2" },
            pattern = "VIS2 packed double add when the operands are vector registers" }
symas.isel{ node = "ctpop", form = "popc", kind = "node", cost = 3, complexity = 3, required = { "popc" } }
symas.isel{ node = "memcpy", form = "prefetch", kind = "node", cost = 1, complexity = 1, flags = { "prefer" } }

symas.fuse{ name = "cmp-br", a = "cmp", b = "br", kind = "cmp_branch", latency = 1,
            flags = { "profitable", "requires_flags", "adjacent" },
            pattern = "SPARC: br on ICC consumes the compare" }
symas.fuse{ name = "cmp-jmpl", a = "cmp", b = "jmpl", kind = "cmp_branch", latency = 1,
            flags = { "profitable", "requires_flags", "adjacent" } }
symas.fuse{ name = "cmp-cbcond", a = "cmp", b = "cbcond", kind = "cmp_branch", latency = 1,
            flags = { "profitable", "requires_flags", "adjacent" },
            pattern = "cbcond folds the compare and the branch into one instruction" }
symas.fuse{ name = "fcmpd-br", a = "fcmpd", b = "br", kind = "cmp_branch", latency = 4,
            flags = { "profitable", "requires_flags", "adjacent" } }
symas.fuse{ name = "ld-add", a = "ld", b = "add", kind = "mem_arith", latency = 6,
            flags = { "profitable", "adjacent" } }
symas.fuse{ name = "sethi-add", a = "sethi", b = "add", kind = "macro", latency = 2,
            flags = { "profitable", "same_reg", "adjacent" },
            pattern = "%hi/%lo sequence for a 32-bit constant" }
symas.fuse{ name = "st-ld", a = "st", b = "ld", kind = "macro", latency = 6,
            flags = { "profitable", "adjacent" }, pattern = "store then reload the same line" }
print(symas.emit())
