# Doxygen configuration for Sandstone (generated by CMake).
PROJECT_NAME           = "Sandstone"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "SymAS-driven assembler framework"
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@ \
                         @CMAKE_SOURCE_DIR@/SYMAS.md \
                         @CMAKE_SOURCE_DIR@/README.md \
                         @CMAKE_SOURCE_DIR@/GUIDE.md \
                         @CMAKE_SOURCE_DIR@/INSTALL.md \
                         @CMAKE_SOURCE_DIR@/include \
                         @CMAKE_SOURCE_DIR@/assembler \
                         @CMAKE_SOURCE_DIR@/compiler/include \
                         @CMAKE_SOURCE_DIR@/compiler/src/spec_compiler.cpp
FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_SOURCE_DIR@/index.md
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
MACRO_EXPANSION        = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
