;;; monoid.olisp -- worked Optilisp monoid example.
;;;
;;; Shows the define-monoid shape used by optilisp/stdlib/monoids/.
;;; Addition over mathematical integers, with identity 0. Trapping machine
;;; addition is not a total operation and does not define this monoid.

(define-monoid
  :id "blackstone.monoid.example-integer-addition"
  :name "Example Integer Addition"
  :carrier mathematical-integer
  :operation integer-add
  :identity 0
  (laws
    (associative integer-add)
    (left-identity integer-add 0)
    (right-identity integer-add 0))
  (description
    "Exact addition over mathematical integers with ordinary equality and identity 0."
    " Associativity and both identity laws hold; no bounded or trapping arithmetic is implied."))
