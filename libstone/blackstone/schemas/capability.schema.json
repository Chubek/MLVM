{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackstone.dev/schemas/capability.schema.json",
  "title": "Blackstone Capability",
  "description": "Schema for a registered NodeIR capability.",
  "type": "object",
  "required": ["id", "name", "description"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "stages": {
      "type": "array",
      "items": { "enum": ["hir", "mir", "lir"] }
    }
  },
  "additionalProperties": false
}
