(define-kernel
  :id "blackstone.hir.algebraic-simplification.and-true"
  :name "Boolean And True Simplification"
  :stage hir
  (category algebraic-simplification)
  (paradigms algebraic-rewriting rule-based)
  (objective "Replace a Boolean and with true with its other operand.")
  (requires
    (capability typed-expressions)
    (capability boolean-semantics))
  (preconditions
    (operand-has-compatible-boolean-type)
    (and-true-is-identity))
  (forbids
    (operation-has-observable-side-effects))
  (transform
    (rewrite (boolean-and x true) x))
  (correctness
    (preserve-observable-behavior))
  (expected-effects "Replaces x && true with x.")
  (limitations "Applies only when Boolean and with true is the identity.")
  (documentation
    (purpose "Simplify Boolean and with true to the other operand.")
    (motivation "Removing identity operations reduces instruction count.")
    (applicability "Applies to Boolean and nodes where one operand is the Boolean constant true.")
    (semantic-assumptions "The Boolean and operation satisfies x && true = x.")
    (known-limitations "Does not apply to bitwise and.")
    (testing-strategy "Both truth values for the other operand are exercised.")))
