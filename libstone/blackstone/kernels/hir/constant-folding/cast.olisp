(define-kernel
  :id "blackstone.hir.constant-folding.cast"
  :name "Constant Cast Folding"
  :stage hir
  (category constant-evaluation)
  (paradigms algebraic-rewriting rule-based)
  (objective "Evaluate a cast whose operand is a known constant.")
  (requires
    (capability typed-expressions)
    (capability integer-constant-operands)
    (capability cast-semantics)
    (analysis constant-value-analysis))
  (preconditions
    (operation-has-defined-compile-time-semantics)
    (result-representable-under-cast-semantics))
  (forbids
    (operation-has-observable-side-effects))
  (transform
    (fold (cast target-type (integer a)) (integer-result (cast-constant target-type a))))
  (correctness
    (preserve-observable-behavior)
    (respect-cast-semantics))
  (expected-effects "Replaces a constant cast with its compile-time value.")
  (limitations "Requires a known constant operand and a representable result under the target type.")
  (documentation
    (purpose "Fold a constant cast into its compile-time result.")
    (motivation "Removing constant casts reduces run-time work and enables downstream rewrites.")
    (applicability "Applies to cast nodes with a known integer constant operand and defined cast semantics.")
    (semantic-assumptions "The IR's cast semantics, including truncation and extension, are preserved.")
    (known-limitations "Does not fold when the result is not representable under the target type.")
    (testing-strategy "Truncating, extending, and same-width cast cases are exercised.")))
