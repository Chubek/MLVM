(define-kernel
  :id "blackstone.hir.constant-folding.integer-rem"
  :name "Integer Remainder Constant Folding"
  :stage hir
  (category constant-evaluation)
  (paradigms algebraic-rewriting rule-based)
  (objective "Evaluate an integer remainder whose operands are both known constants.")
  (requires
    (capability typed-expressions)
    (capability integer-constant-operands)
    (analysis constant-value-analysis))
  (preconditions
    (operation-has-defined-compile-time-semantics)
    (divisor-is-nonzero)
    (result-representable-under-integer-semantics))
  (forbids
    (operation-has-observable-side-effects)
    (division-by-zero))
  (transform
    (fold (rem (integer a) (integer b)) (integer-result (integer-rem a b))))
  (correctness
    (preserve-observable-behavior)
    (respect-integer-division-semantics))
  (expected-effects "Replaces a constant integer remainder with its compile-time value.")
  (limitations "Requires a nonzero divisor and a representable result.")
  (documentation
    (purpose "Fold a constant integer remainder into its compile-time result.")
    (motivation "Removing constant arithmetic reduces run-time work.")
    (applicability "Applies to integer remainder nodes with known constant operands and a nonzero divisor.")
    (semantic-assumptions "The IR's remainder semantics are preserved.")
    (known-limitations "Does not fold when the divisor is zero.")
    (testing-strategy "Normal, zero-divisor, and sign cases are exercised.")))
