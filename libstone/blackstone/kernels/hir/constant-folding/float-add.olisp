(define-kernel
  :id "blackstone.hir.constant-folding.float-add"
  :name "Floating-Point Addition Constant Folding"
  :stage hir
  (category constant-evaluation)
  (paradigms algebraic-rewriting rule-based)
  (objective "Evaluate a floating-point addition whose operands are both known constants.")
  (requires
    (capability typed-expressions)
    (capability floating-point-constant-operands)
    (capability floating-point-semantics)
    (analysis constant-value-analysis))
  (preconditions
    (operation-has-defined-compile-time-semantics)
    (result-representable-under-floating-point-semantics))
  (forbids
    (operation-has-observable-side-effects)
    (floating-point-exceptions-are-observable))
  (transform
    (fold (float-add (float a) (float b)) (float-result (float-add a b))))
  (correctness
    (preserve-observable-behavior)
    (respect-floating-point-rounding))
  (expected-effects "Replaces a constant floating-point addition with its compile-time value.")
  (limitations "Requires both operands to be known constants and a representable result.")
  (documentation
    (purpose "Fold a constant floating-point addition into its compile-time result.")
    (motivation "Removing constant arithmetic reduces run-time work.")
    (applicability "Applies to floating-point addition nodes with two known constant operands.")
    (semantic-assumptions "The IR's floating-point semantics, including rounding and special values, are preserved.")
    (known-limitations "Does not fold when the result is not representable or exceptions are observable.")
    (testing-strategy "Normal, special-value, and rounding boundary cases are exercised.")))
