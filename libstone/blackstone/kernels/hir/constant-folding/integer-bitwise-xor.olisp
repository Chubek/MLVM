(define-kernel
  :id "blackstone.hir.constant-folding.integer-bitwise-xor"
  :name "Integer Bitwise Xor Constant Folding"
  :stage hir
  (category constant-evaluation)
  (paradigms algebraic-rewriting rule-based)
  (objective "Evaluate a bitwise xor whose operands are both known constants.")
  (requires
    (capability typed-expressions)
    (capability integer-constant-operands)
    (analysis constant-value-analysis))
  (preconditions
    (operation-has-defined-compile-time-semantics))
  (forbids
    (operation-has-observable-side-effects))
  (transform
    (fold (bitwise-xor (integer a) (integer b)) (integer-result (bitwise-xor a b))))
  (correctness
    (preserve-observable-behavior))
  (expected-effects "Replaces a constant bitwise xor with its compile-time value.")
  (limitations "Requires both operands to be known constants.")
  (documentation
    (purpose "Fold a constant bitwise xor into its compile-time result.")
    (motivation "Removing constant bitwise operations reduces run-time work.")
    (applicability "Applies to bitwise xor nodes with two known integer constant operands.")
    (semantic-assumptions "The IR's bitwise semantics are preserved.")
    (known-limitations "Does not propagate constants.")
    (testing-strategy "Equal, disjoint, and mixed cases are exercised.")))
