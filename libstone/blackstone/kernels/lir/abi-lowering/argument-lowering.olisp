(define-kernel
  :id "blackstone.lir.abi.argument-lowering"
  :name "Argument Lowering"
  :stage lir
  (category abi-lowering)
  (paradigms target-specific)
  (objective "Lower function arguments to the target calling convention.")
  (requires
    (capability machine-operations)
    (capability calling-convention)
    (capability abi-information)
    (capability argument-lowering-information))
  (preconditions
    (calling-convention-is-defined))
  (forbids
    (unmodeled-observable-effects))
  (transform
    (lower (function-args args) (calling-convention-args lowered)))
  (correctness
    (preserve-observable-behavior))
  (expected-effects "Lowers function arguments to the target calling convention.")
  (limitations "Applies only when the calling convention is defined.")
  (documentation
    (purpose "Lower function arguments to the target calling convention.")
    (motivation "Argument lowering maps arguments to registers and stack slots.")
    (applicability "Applies to function arguments when the calling convention is defined.")
    (semantic-assumptions "The calling convention is defined.")
    (known-limitations "Does not lower when the calling convention is undefined.")
    (testing-strategy "Register, stack, and boundary argument cases are exercised.")))
