(define-kernel
  :id "blackstone.lir.instruction-selection.addressing-mode-selection"
  :name "Addressing Mode Selection"
  :stage lir
  (category instruction-selection)
  (paradigms target-specific)
  (objective "Select the best addressing mode for memory operations.")
  (requires
    (capability machine-operations)
    (capability target-description)
    (capability addressing-modes))
  (preconditions
    (target-description-is-available))
  (forbids
    (unmodeled-observable-effects))
  (transform
    (select (memory-op op) (best-addressing-mode mode)))
  (correctness
    (preserve-observable-behavior))
  (expected-effects "Selects the best addressing mode for memory operations.")
  (limitations "Applies only when the target description is available.")
  (documentation
    (purpose "Select the best addressing mode for memory operations.")
    (motivation "Addressing mode selection reduces instruction count.")
    (applicability "Applies to memory operations when the target description is available.")
    (semantic-assumptions "The target description is available.")
    (known-limitations "Does not select when the target description is unavailable.")
    (testing-strategy "Direct, indirect, and boundary addressing mode cases are exercised.")))
