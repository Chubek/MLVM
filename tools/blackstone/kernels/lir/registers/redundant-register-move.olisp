; MLVM supplement: schema profile 1; declarative, not executable NodeIR.
(define-kernel
  :id "blackstone.lir.registers.redundant-register-move"
  :name "Redundant register move"
  :stage lir
  (category instruction-combination)
  (paradigms graph-rewriting rule-based)
  (objective "Replace (move register register) with (removed-move) when the declared proof obligations hold.")
  (requires
    (capability machine-operations)
    (capability target-description)
    (analysis liveness-analysis))
  (preconditions move-has-no-lane-extension-flags-or-clobber-effects operand-and-result-types-compatible operand-values-defined source-effects-traps-and-exceptions-preserved result-satisfies-stage-invariants target-flags-clobbers-and-register-constraints-preserved)
  (forbids unmodeled-observable-effects invalidated-input-analysis)
  (analysis-contract
    (requires liveness-analysis)
    (invalidates liveness-analysis live-range-analysis)
    (preserves))
  (transform (rewrite (move register register) (removed-move)))
  (correctness preserve-observable-behavior preserve-stage-invariants preserve-source-provenance)
  (expected-effects "Simplifies the matched representation; runtime benefit and code-size change depend on the surrounding program and target.")
  (limitations "Declarative contract only; NodeIR matching and execution require an external adapter. Same register names do not imply a no-op: reject moves that zero upper lanes, alter flags, or carry effects.")
