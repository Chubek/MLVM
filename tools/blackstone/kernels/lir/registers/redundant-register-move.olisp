    (purpose "Replace (move register register) with (removed-move) when the declared proof obligations hold.")
    (motivation "Expose the redundant register move opportunity for planners with explicit legality facts.")
    (stage "NodeLIR; all required capabilities must be supplied explicitly.")
    (applicability "Match (move register register); require a proven true move-has-no-lane-extension-flags-or-clobber-effects fact.")
