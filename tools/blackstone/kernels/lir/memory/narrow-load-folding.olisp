; MLVM supplement: schema profile 1; declarative, not executable NodeIR.
(define-kernel
  :id "blackstone.lir.memory.narrow-load-folding"
  :name "Narrow load folding"
  :stage lir
  (category instruction-combination)
  (paradigms graph-rewriting rule-based)
  (objective "Replace (truncate (wide-load address)) with (narrow-load address) when the declared proof obligations hold.")
  (requires
    (capability machine-operations)
    (capability target-description)
    (analysis liveness-analysis))
  (preconditions narrow-load-access-and-trap-equivalence-proven operand-and-result-types-compatible operand-values-defined source-effects-traps-and-exceptions-preserved result-satisfies-stage-invariants target-flags-clobbers-and-register-constraints-preserved)
  (forbids unmodeled-observable-effects invalidated-input-analysis volatile-or-atomic-access unknown-memory-dependence external-memory-observation-changes)
  (analysis-contract
    (requires liveness-analysis)
    (invalidates liveness-analysis live-range-analysis)
    (preserves))
  (transform (rewrite (truncate (wide-load address)) (narrow-load address)))
  (correctness preserve-observable-behavior preserve-stage-invariants preserve-source-provenance)
  (expected-effects "Simplifies the matched representation; runtime benefit and code-size change depend on the surrounding program and target.")
  (limitations "Declarative contract only; NodeIR matching and execution require an external adapter. Different access widths may change faults, MMIO, atomicity, and endian-selected bytes; prove equivalence.")
  (documentation
    (purpose "Replace (truncate (wide-load address)) with (narrow-load address) when the declared proof obligations hold.")
    (motivation "Expose the narrow load folding opportunity for planners with explicit legality facts.")
    (stage "NodeLIR; all required capabilities must be supplied explicitly.")
    (applicability "Match (truncate (wide-load address)); require a proven true narrow-load-access-and-trap-equivalence-proven fact.")
    (preconditions "Required true facts: narrow-load-access-and-trap-equivalence-proven, operand-and-result-types-compatible, operand-values-defined, source-effects-traps-and-exceptions-preserved, result-satisfies-stage-invariants, target-flags-clobbers-and-register-constraints-preserved.")
    (required-information "Capabilities: machine-operations, target-description; analyses: liveness-analysis. Results must be current.")
    (transformation "Replace (truncate (wide-load address)) with (narrow-load address) when the declared proof obligations hold. Preserve source provenance and update uses and edges consistently.")
    (semantic-assumptions "Different access widths may change faults, MMIO, atomicity, and endian-selected bytes; prove equivalence.")
    (correctness "Preserve required observable behavior under the declared execution model; unknown facts never justify the rewrite.")
    (known-limitations "Declarative contract only; NodeIR matching and execution require an external adapter. Different access widths may change faults, MMIO, atomicity, and endian-selected bytes; prove equivalence.")
    (expected-effects "Simplifies the matched representation; runtime benefit and code-size change depend on the surrounding program and target.")
    (testing-strategy "tests/test_catalog.py checks positive, rejected, unknown, invalidated, and stage-mismatch applicability for blackstone.lir.memory.narrow-load-folding. Integer-model tests cover HIR identities; other transformations have no executable NodeIR evidence.")
    (references "Blackstone AGENTS.md sections 4, 5, 11, 12, 17, and 18; tools/blackstone/README.md contract semantics.")
    (recommended-tools "No external library recommended; execution integration remains optional.")))
