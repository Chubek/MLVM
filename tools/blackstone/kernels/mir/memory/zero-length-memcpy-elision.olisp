; MLVM supplement: schema profile 1; declarative, not executable NodeIR.
(define-kernel
  :id "blackstone.mir.memory.zero-length-memcpy-elision"
  :name "Zero length memcpy elision"
  :stage mir
  (category memory-optimization)
  (paradigms graph-rewriting rule-based)
  (objective "Replace (memcpy dst src zero) with (removed-copy) when the declared proof obligations hold.")
  (requires
    (capability ssa-form)
    (capability memory-effects)
    (analysis dominator-analysis)
    (analysis alias-analysis)
    (analysis memory-dependence-analysis)
    (analysis side-effect-analysis)
    (analysis exception-analysis))
  (preconditions zero-length-copy-has-no-pointer-validation-effects operand-and-result-types-compatible operand-values-defined source-effects-traps-and-exceptions-preserved result-satisfies-stage-invariants)
  (forbids unmodeled-observable-effects invalidated-input-analysis volatile-or-atomic-access unknown-memory-dependence external-memory-observation-changes)
  (analysis-contract
    (requires dominator-analysis alias-analysis memory-dependence-analysis side-effect-analysis exception-analysis)
    (invalidates alias-analysis constant-value-analysis dominator-analysis exception-analysis liveness-analysis memory-dependence-analysis side-effect-analysis)
    (preserves))
  (transform (rewrite (memcpy dst src zero) (removed-copy)))
  (correctness preserve-observable-behavior preserve-stage-invariants preserve-source-provenance)
  (expected-effects "Simplifies the matched representation; runtime benefit and code-size change depend on the surrounding program and target.")
  (limitations "Declarative contract only; NodeIR matching and execution require an external adapter. The IR must permit zero-length copy removal even for invalid pointers; otherwise retain it.")
  (documentation
    (purpose "Replace (memcpy dst src zero) with (removed-copy) when the declared proof obligations hold.")
    (motivation "Expose the zero length memcpy elision opportunity for planners with explicit legality facts.")
    (stage "NodeMIR; all required capabilities must be supplied explicitly.")
    (applicability "Match (memcpy dst src zero); require a proven true zero-length-copy-has-no-pointer-validation-effects fact.")
    (preconditions "Required true facts: zero-length-copy-has-no-pointer-validation-effects, operand-and-result-types-compatible, operand-values-defined, source-effects-traps-and-exceptions-preserved, result-satisfies-stage-invariants.")
    (required-information "Capabilities: ssa-form, memory-effects; analyses: dominator-analysis, alias-analysis, memory-dependence-analysis, side-effect-analysis, exception-analysis. Results must be current.")
    (transformation "Replace (memcpy dst src zero) with (removed-copy) when the declared proof obligations hold. Preserve source provenance and update uses and edges consistently.")
    (semantic-assumptions "The IR must permit zero-length copy removal even for invalid pointers; otherwise retain it.")
    (correctness "Preserve required observable behavior under the declared execution model; unknown facts never justify the rewrite.")
    (known-limitations "Declarative contract only; NodeIR matching and execution require an external adapter. The IR must permit zero-length copy removal even for invalid pointers; otherwise retain it.")
    (expected-effects "Simplifies the matched representation; runtime benefit and code-size change depend on the surrounding program and target.")
    (testing-strategy "tests/test_catalog.py checks positive, rejected, unknown, invalidated, and stage-mismatch applicability for blackstone.mir.memory.zero-length-memcpy-elision. Integer-model tests cover HIR identities; other transformations have no executable NodeIR evidence.")
    (references "Blackstone AGENTS.md sections 4, 5, 11, 12, 17, and 18; tools/blackstone/README.md contract semantics.")
    (recommended-tools "No external library recommended; execution integration remains optional.")))
