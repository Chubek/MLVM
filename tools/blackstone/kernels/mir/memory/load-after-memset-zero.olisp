    (capability ssa-form)
    (capability memory-effects)
    (analysis dominator-analysis)
    (analysis alias-analysis)
    (analysis memory-dependence-analysis)
    (analysis side-effect-analysis)
    (analysis exception-analysis))
  (preconditions complete-byte-coverage-and-no-clobber-proven operand-and-result-types-compatible operand-values-defined source-effects-traps-and-exceptions-preserved result-satisfies-stage-invariants)
