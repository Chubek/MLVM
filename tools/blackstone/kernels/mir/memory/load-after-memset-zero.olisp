(define-kernel
  :id "blackstone.mir.memory.load-after-memset-zero"
  :name "Load after memset zero"
  :stage mir
  (category memory-optimization)
  (paradigms graph-rewriting rule-based)
  (objective "Replace (load-after-memset address bytes) with (zero-value bytes) when the declared proof obligations hold.")
