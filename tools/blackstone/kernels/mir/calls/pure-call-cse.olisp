; MLVM supplement: schema profile 1; declarative, not executable NodeIR.
(define-kernel
  :id "blackstone.mir.calls.pure-call-cse"
  :name "Pure call cse"
  :stage mir
  (category interprocedural-optimization)
  (paradigms graph-rewriting rule-based)
  (objective "Replace (repeat-pure-call callee args) with (previous-call-result callee args) when the declared proof obligations hold.")
  (requires
    (capability ssa-form)
    (capability call-graph)
    (capability interprocedural-summaries)
    (analysis dominator-analysis)
    (analysis call-graph-analysis)
    (analysis side-effect-analysis)
    (analysis exception-analysis))
  (preconditions deterministic-total-call-and-dominance-proven operand-and-result-types-compatible operand-values-defined source-effects-traps-and-exceptions-preserved result-satisfies-stage-invariants)
  (forbids unmodeled-observable-effects invalidated-input-analysis)
  (analysis-contract
    (requires dominator-analysis call-graph-analysis side-effect-analysis exception-analysis)
    (invalidates call-graph-analysis constant-value-analysis dominator-analysis exception-analysis liveness-analysis side-effect-analysis)
    (preserves))
  (transform (rewrite (repeat-pure-call callee args) (previous-call-result callee args)))
  (correctness preserve-observable-behavior preserve-stage-invariants preserve-source-provenance)
  (expected-effects "Simplifies the matched representation; runtime benefit and code-size change depend on the surrounding program and target.")
  (limitations "Declarative contract only; NodeIR matching and execution require an external adapter. Purity alone does not imply determinism or absence of traps; require all three plus equivalent arguments.")
  (documentation
    (purpose "Replace (repeat-pure-call callee args) with (previous-call-result callee args) when the declared proof obligations hold.")
    (motivation "Expose the pure call cse opportunity for planners with explicit legality facts.")
    (stage "NodeMIR; all required capabilities must be supplied explicitly.")
    (applicability "Match (repeat-pure-call callee args); require a proven true deterministic-total-call-and-dominance-proven fact.")
    (preconditions "Required true facts: deterministic-total-call-and-dominance-proven, operand-and-result-types-compatible, operand-values-defined, source-effects-traps-and-exceptions-preserved, result-satisfies-stage-invariants.")
    (required-information "Capabilities: ssa-form, call-graph, interprocedural-summaries; analyses: dominator-analysis, call-graph-analysis, side-effect-analysis, exception-analysis. Results must be current.")
    (transformation "Replace (repeat-pure-call callee args) with (previous-call-result callee args) when the declared proof obligations hold. Preserve source provenance and update uses and edges consistently.")
    (semantic-assumptions "Purity alone does not imply determinism or absence of traps; require all three plus equivalent arguments.")
    (correctness "Preserve required observable behavior under the declared execution model; unknown facts never justify the rewrite.")
    (known-limitations "Declarative contract only; NodeIR matching and execution require an external adapter. Purity alone does not imply determinism or absence of traps; require all three plus equivalent arguments.")
    (expected-effects "Simplifies the matched representation; runtime benefit and code-size change depend on the surrounding program and target.")
    (testing-strategy "tests/test_catalog.py checks positive, rejected, unknown, invalidated, and stage-mismatch applicability for blackstone.mir.calls.pure-call-cse. Integer-model tests cover HIR identities; other transformations have no executable NodeIR evidence.")
    (references "Blackstone AGENTS.md sections 4, 5, 11, 12, 17, and 18; tools/blackstone/README.md contract semantics.")
    (recommended-tools "No external library recommended; execution integration remains optional.")))
