# Keep the downloaded dependency pristine. Apply the embedding corrections to
# a build-local copy; nothing is fetched and no grammar is regenerated.
# Source: third_party/ucpp (see get-deps.sh)
set(MLVM_UCPP_SOURCE_DIR "${MLVM_THIRD_PARTY_DIR}/ucpp"
  CACHE PATH "ucpp preprocessor sources (populated by get-deps.sh)")
if(MLVM_ENABLE_CEPHYR STREQUAL "OFF")
  return()
endif()
set(ucpp_sources mem.c nhash.c cpp.c lexer.c assert.c macro.c eval.c)
set(ucpp_check_files)
foreach(file mem.c nhash.c cpp.c lexer.c assert.c macro.c eval.c arith.c)
  list(APPEND ucpp_check_files "${file}")
endforeach()
foreach(file cpp.h ucppi.h mem.h nhash.h arith.h config.h tune.h LICENSE)
  list(APPEND ucpp_check_files "${file}")
endforeach()
foreach(file IN LISTS ucpp_check_files)
  if(NOT EXISTS "${MLVM_UCPP_SOURCE_DIR}/${file}")
    if(MLVM_CEPHYR_WANT_ON)
      message(FATAL_ERROR "Cephyr requires ucpp: missing ${MLVM_UCPP_SOURCE_DIR}/${file}")
    endif()
    message(STATUS "Cephyr disabled: ucpp unavailable")
    set(MLVM_ENABLE_CEPHYR OFF)
    return()
  endif()
endforeach()
find_package(Python3 COMPONENTS Interpreter REQUIRED)
set(ucpp_adapter "${CMAKE_CURRENT_SOURCE_DIR}/cephyr/src/preprocess/ucpp")
set(ucpp_prepared "${CMAKE_CURRENT_BINARY_DIR}/ucpp")
file(GLOB ucpp_adapter_files CONFIGURE_DEPENDS "${ucpp_adapter}/*")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${ucpp_adapter_files})
foreach(file IN LISTS ucpp_check_files)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MLVM_UCPP_SOURCE_DIR}/${file}")
endforeach()
execute_process(COMMAND "${Python3_EXECUTABLE}" "${ucpp_adapter}/prepare.py"
  "${MLVM_UCPP_SOURCE_DIR}" "${ucpp_prepared}" RESULT_VARIABLE ucpp_result)
if(NOT ucpp_result EQUAL 0)
  message(FATAL_ERROR "Unable to prepare ucpp embedding adapter")
endif()
add_library(mlvm_ucpp STATIC)
foreach(file mem nhash cpp lexer assert macro eval)
  target_sources(mlvm_ucpp PRIVATE "${ucpp_prepared}/${file}.c")
endforeach()
target_include_directories(mlvm_ucpp SYSTEM PUBLIC
  $<BUILD_INTERFACE:${ucpp_prepared}>)
target_compile_definitions(mlvm_ucpp PUBLIC UCPP_CONFIG NO_UCPP_ERROR_FUNCTIONS)
set_target_properties(mlvm_ucpp PROPERTIES
  C_STANDARD 11
  POSITION_INDEPENDENT_CODE ON)
set(MLVM_ENABLE_CEPHYR ON)
