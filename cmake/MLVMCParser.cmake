# Keep the downloaded dependency pristine. Apply the embedding corrections to
# a build-local copy; neither a network fetch nor parser generation is needed.
# Source: third_party/cparser-iso11 (see get-deps.sh)
set(MLVM_CPARSER_SOURCE_DIR "${MLVM_THIRD_PARTY_DIR}/cparser-iso11"
  CACHE PATH "cparser-iso11 frontend sources (populated by get-deps.sh)")
if(MLVM_ENABLE_CEPHYR STREQUAL "OFF")
  return()
endif()
set(cparser_files)
foreach(file CParser Parser Lexer CLexer ASTNode AbstractSyntaxTree SymbolTable TreeVisitor)
  list(APPEND cparser_files "src/${file}.cpp" "include/${file}.h")
endforeach()
list(APPEND cparser_files include/common.h include/PrintTreeVisitor.h LICENSE)
foreach(file IN LISTS cparser_files)
  if(NOT EXISTS "${MLVM_CPARSER_SOURCE_DIR}/${file}")
    if(MLVM_CEPHYR_WANT_ON)
      message(FATAL_ERROR "Cephyr requires cparser-iso11: missing ${MLVM_CPARSER_SOURCE_DIR}/${file}")
    endif()
    message(STATUS "Cephyr disabled: cparser-iso11 unavailable")
    set(MLVM_ENABLE_CEPHYR OFF)
    return()
  endif()
endforeach()
find_package(Python3 COMPONENTS Interpreter REQUIRED)
set(adapter "${CMAKE_CURRENT_SOURCE_DIR}/cephyr/src/parse/cparser")
set(prepared "${CMAKE_CURRENT_BINARY_DIR}/cparser-iso11")
file(GLOB adapter_files CONFIGURE_DEPENDS "${adapter}/*")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${adapter_files})
foreach(file IN LISTS cparser_files)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MLVM_CPARSER_SOURCE_DIR}/${file}")
endforeach()
execute_process(COMMAND "${Python3_EXECUTABLE}" "${adapter}/prepare.py"
  "${MLVM_CPARSER_SOURCE_DIR}" "${prepared}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Unable to prepare cparser-iso11 embedding adapter")
endif()
add_library(mlvm_cparser STATIC)
foreach(file CParser Parser Lexer CLexer ASTNode AbstractSyntaxTree SymbolTable TreeVisitor)
  target_sources(mlvm_cparser PRIVATE "${prepared}/src/${file}.cpp")
endforeach()
target_include_directories(mlvm_cparser SYSTEM PUBLIC
  $<BUILD_INTERFACE:${prepared}/include> $<BUILD_INTERFACE:${adapter}>)
target_compile_features(mlvm_cparser PRIVATE cxx_std_20)
set_target_properties(mlvm_cparser PROPERTIES POSITION_INDEPENDENT_CODE ON)
set(MLVM_ENABLE_CEPHYR ON)
